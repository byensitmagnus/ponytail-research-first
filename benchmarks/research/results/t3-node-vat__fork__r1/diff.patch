+// VAT number check used by the B2B checkout. See TASK.md.
+
+// VAT format patterns for each EU member state + Northern Ireland
+// Source: https://ec.europa.eu/taxation_customs/vies/faqvies.do
+const VAT_FORMATS = {
+  // EU27 + Greece (EL) and Northern Ireland (XI)
+  AT: /^AT\d{9}$/,          // Austria
+  BE: /^BE\d{10}$/,         // Belgium
+  BG: /^BG\d{9,10}$/,       // Bulgaria
+  HR: /^HR\d{11}$/,         // Croatia
+  CY: /^CY\d{8}[A-Z]$/,     // Cyprus
+  CZ: /^CZ\d{8,10}$/,       // Czech Republic
+  DK: /^DK\d{8}$/,          // Denmark
+  EE: /^EE\d{9}$/,          // Estonia
+  FI: /^FI\d{8}$/,          // Finland
+  FR: /^FR[A-Z0-9]{2}\d{9}$/,  // France
+  DE: /^DE\d{9}$/,          // Germany
+  EL: /^EL\d{9}$/,          // Greece
+  HU: /^HU\d{8}$/,          // Hungary
+  IE: /^IE\d{7}[A-Z]|\d{8}$/,  // Ireland (complex format)
+  IT: /^IT\d{11}$/,         // Italy
+  LV: /^LV\d{11}$/,         // Latvia
+  LT: /^LT(\d{9}|\d{12})$/, // Lithuania
+  LU: /^LU\d{8}$/,          // Luxembourg
+  MT: /^MT\d{8}$/,          // Malta
+  NL: /^NL\d{9}B\d{2}$/,    // Netherlands
+  PL: /^PL\d{10}$/,         // Poland
+  PT: /^PT\d{9}$/,          // Portugal
+  RO: /^RO\d{2,10}$/,       // Romania
+  SK: /^SK\d{10}$/,         // Slovakia
+  SI: /^SI\d{8}$/,          // Slovenia
+  ES: /^ES[A-Z0-9]\d{7}[A-Z0-9]$/,  // Spain
+  SE: /^SE\d{12}$/,         // Sweden
+  XI: /^XI\d{9}|\d{12}$/,   // Northern Ireland
+};
+
+/**
+ * Normalize VAT input: remove spaces, dashes, dots; uppercase
+ */
+function normalizeInput(input) {
+  if (typeof input !== 'string') return null;
+  return input.replace(/[\s\-\.]/g, '').toUpperCase();
+}
+
+/**
+ * Parse VAT number into country code and number
+ */
+function parseVat(normalized) {
+  const match = normalized.match(/^([A-Z]{2})(.+)$/);
+  if (!match) return null;
+
+  const [, countryCode, vatNumber] = match;
+  return { countryCode, vatNumber: vatNumber.toUpperCase() };
+}
+
+/**
+ * Validate VAT format for known country
+ */
+function isValidFormat(countryCode, vatNumber) {
+  const pattern = VAT_FORMATS[countryCode];
+  if (!pattern) return false;
+  return pattern.test(countryCode + vatNumber);
+}
+
+/**
+ * Call VIES service to verify VAT
+ * Uses fetch with 10-second timeout
+ */
+async function verifyWithVies(countryCode, vatNumber, fetchFn, timeoutMs = 10000) {
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
+
+  try {
+    // VIES service expects XML POST request
+    const soapBody = `<?xml version="1.0" encoding="UTF-8"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:vat="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+  <soap:Body>
+    <vat:checkVat>
+      <vat:countryCode>${escapeXml(countryCode)}</vat:countryCode>
+      <vat:vatNumber>${escapeXml(vatNumber)}</vat:vatNumber>
+    </vat:checkVat>
+  </soap:Body>
+</soap:Envelope>`;
+
+    const response = await fetchFn('http://ec.europa.eu/taxation_customs/vies/services/checkVatService', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'text/xml; charset=UTF-8',
+        'SOAPAction': '',
+      },
+      body: soapBody,
+      signal: controller.signal,
+    });
+
+    if (!response.ok) {
+      return { valid: null, reason: `HTTP ${response.status}` };
+    }
+
+    const text = await response.text();
+
+    // Parse SOAP response
+    const validMatch = text.match(/<valid>([^<]+)<\/valid>/);
+    const nameMatch = text.match(/<name>([^<]*)<\/name>/);
+    const addressMatch = text.match(/<address>([^<]*)<\/address>/);
+
+    if (!validMatch) {
+      // Check for fault
+      if (text.includes('faultstring')) {
+        const faultMatch = text.match(/<faultstring>([^<]+)<\/faultstring>/);
+        return { valid: null, reason: faultMatch ? faultMatch[1] : 'VIES service error' };
+      }
+      return { valid: null, reason: 'Invalid VIES response' };
+    }
+
+    const valid = validMatch[1].toLowerCase() === 'true';
+    return {
+      valid,
+      name: nameMatch ? decodeXml(nameMatch[1]) : undefined,
+      address: addressMatch ? decodeXml(addressMatch[1]) : undefined,
+    };
+  } catch (err) {
+    if (err.name === 'AbortError') {
+      return { valid: null, reason: 'Verification timeout' };
+    }
+    return { valid: null, reason: err.message };
+  } finally {
+    clearTimeout(timeoutId);
+  }
+}
+
+/**
+ * Simple XML escaping
+ */
+function escapeXml(str) {
+  return str.replace(/[&<>"']/g, (ch) => {
+    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;' };
+    return map[ch];
+  });
+}
+
+/**
+ * Simple XML entity decoding
+ */
+function decodeXml(str) {
+  return str
+    .replace(/&apos;/g, "'")
+    .replace(/&quot;/g, '"')
+    .replace(/&gt;/g, '>')
+    .replace(/&lt;/g, '<')
+    .replace(/&amp;/g, '&');
+}
+
+/**
+ * Check EU VAT number validity
+ *
+ * @param {string} input - VAT number with optional country prefix (e.g., "DK 12 34 56 78" or "de129273398")
+ * @param {object} options - Optional configuration
+ * @param {function} options.fetch - Custom fetch implementation (defaults to global fetch)
+ * @returns {Promise<object>} Result object with status, valid, and optionally countryCode, vatNumber, name, address, reason
+ */
+export async function checkVat(input, options = {}) {
+  const fetchFn = options.fetch || (typeof fetch !== 'undefined' ? fetch : null);
+
+  // Normalize input
+  const normalized = normalizeInput(input);
+  if (!normalized) {
+    return { status: 'malformed', valid: false };
+  }
+
+  // Parse VAT
+  const parsed = parseVat(normalized);
+  if (!parsed) {
+    return { status: 'malformed', valid: false };
+  }
+
+  const { countryCode, vatNumber } = parsed;
+
+  // Check format
+  if (!isValidFormat(countryCode, vatNumber)) {
+    return { status: 'malformed', valid: false, countryCode, vatNumber };
+  }
+
+  // If no fetch available, return unverified
+  if (!fetchFn) {
+    return { status: 'unverified', valid: null, countryCode, vatNumber, reason: 'No network available' };
+  }
+
+  // Verify with VIES
+  const viesResult = await verifyWithVies(countryCode, vatNumber, fetchFn);
+
+  if (viesResult.valid === null) {
+    return {
+      status: 'unverified',
+      valid: null,
+      countryCode,
+      vatNumber,
+      reason: viesResult.reason,
+    };
+  }
+
+  return {
+    status: viesResult.valid ? 'valid' : 'invalid',
+    valid: viesResult.valid,
+    countryCode,
+    vatNumber,
+    name: viesResult.name,
+    address: viesResult.address,
+  };
+}
