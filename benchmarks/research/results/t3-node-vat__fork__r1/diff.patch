+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { checkVat } from '../src/vat.js';
+
+test('checkVat is exported', () => {
+  assert.equal(typeof checkVat, 'function');
+});
+
+test('Format validation - malformed input', async () => {
+  const result = await checkVat('XX123456789');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('Format validation - unknown country', async () => {
+  const result = await checkVat('ZZ123456789');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('Format validation - invalid format for country', async () => {
+  // Denmark (DK) requires 8 digits, this has too many
+  const result = await checkVat('DK 123456789');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('Format validation - accepts spaces and dashes', async () => {
+  // Valid DK format: 8 digits
+  const mockFetch = () => Promise.resolve({
+    ok: true,
+    text: () => Promise.resolve(`
+      <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+        <soap:Body>
+          <checkVatResponse xmlns="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+            <valid>true</valid>
+            <name>Test Company</name>
+            <address>Test Address</address>
+          </checkVatResponse>
+        </soap:Body>
+      </soap:Envelope>
+    `),
+  });
+
+  const result = await checkVat('DK 12 34 56 78', { fetch: mockFetch });
+  assert.equal(result.status, 'valid');
