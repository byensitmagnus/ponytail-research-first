+<?php
+/**
+ * Plugin Name: WooCommerce B2B
+ * Description: B2B customer support with company info and approval workflow
+ * Version: 1.0.0
+ * Author: Generated
+ * Text Domain: woocommerce-b2b
+ * Domain Path: /languages
+ */
+
+// Registration form: add company name and VAT fields
+add_action( 'woocommerce_register_form', function() {
+	woocommerce_form_field(
+		'billing_company_name',
+		array(
+			'type'        => 'text',
+			'class'       => array( 'form-row-wide' ),
+			'label'       => __( 'Company Name', 'woocommerce-b2b' ),
+			'required'    => false,
+		),
+		isset( $_POST['post_data'] ) ? esc_attr( wp_unslash( $_POST['post_data'] ) ) : ''
+	);
+
+	woocommerce_form_field(
+		'billing_vat_number',
+		array(
+			'type'        => 'text',
+			'class'       => array( 'form-row-wide' ),
+			'label'       => __( 'VAT Number', 'woocommerce-b2b' ),
+			'required'    => false,
+		),
+		isset( $_POST['post_data'] ) ? esc_attr( wp_unslash( $_POST['post_data'] ) ) : ''
+	);
+} );
+
+// Save B2B fields on user registration
+add_action( 'woocommerce_created_customer', function( $customer_id ) {
+	if ( isset( $_POST['post_data'] ) ) {
+		parse_str( sanitize_text_field( wp_unslash( $_POST['post_data'] ) ), $post_data );
+
+		if ( isset( $post_data['billing_company_name'] ) ) {
+			update_user_meta( $customer_id, 'billing_company_name', sanitize_text_field( $post_data['billing_company_name'] ) );
+		}
+
+		if ( isset( $post_data['billing_vat_number'] ) ) {
+			update_user_meta( $customer_id, 'billing_vat_number', sanitize_text_field( $post_data['billing_vat_number'] ) );
+		}
+	}
+} );
+
+// Get B2B price if user is approved and product has B2B pricing
+function woocommerce_b2b_get_product_price( $product ) {
+	if ( ! is_user_logged_in() ) {
+		return null;
+	}
+	$user_id = get_current_user_id();
+	$b2b_approved = get_user_meta( $user_id, '_b2b_approved', true );
+
+	if ( $b2b_approved ) {
+		$b2b_price = get_post_meta( $product->get_id(), '_b2b_price', true );
+		if ( $b2b_price ) {
+			return (float) $b2b_price;
+		}
+	}
+	return null;
+}
+
+// Filter product prices for B2B customers (frontend display)
+add_filter( 'woocommerce_get_price_html', function( $price_html, $product ) {
+	$b2b_price = woocommerce_b2b_get_product_price( $product );
+	if ( $b2b_price !== null ) {
+		return wc_price( $b2b_price );
+	}
+	return $price_html;
+}, 10, 2 );
+
+// Filter price getter (used by cart/checkout)
+add_filter( 'woocommerce_product_get_price', function( $price, $product ) {
+	$b2b_price = woocommerce_b2b_get_product_price( $product );
+	return $b2b_price !== null ? $b2b_price : $price;
+}, 10, 2 );
+
+// Filter regular price getter (used by Store API)
+add_filter( 'woocommerce_product_get_regular_price', function( $price, $product ) {
+	$b2b_price = woocommerce_b2b_get_product_price( $product );
+	return $b2b_price !== null ? $b2b_price : $price;
+}, 10, 2 );
+
+// Rest API: Modify product response with correct price
+add_filter( 'woocommerce_rest_prepare_product_object', function( $response, $product, $request ) {
+	$b2b_price = woocommerce_b2b_get_product_price( $product );
+	if ( $b2b_price !== null ) {
+		$data = $response->get_data();
+		$data['price'] = $b2b_price;
+		$data['regular_price'] = $b2b_price;
+		$response->set_data( $data );
+	}
+	return $response;
+}, 10, 3 );
