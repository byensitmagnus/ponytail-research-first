 """Product search for the shop. See TASK.md."""
 import csv
 from pathlib import Path
+from rapidfuzz import fuzz
 
 DATA = Path(__file__).resolve().parent.parent / "data" / "products.csv"
 
@@ -9,6 +10,30 @@ with DATA.open(encoding="utf-8") as f:
 
 
 def search(query: str, limit: int = 10) -> list[dict]:
-    """Return up to `limit` products, best match first."""
-    q = query.lower()
-    return [p for p in PRODUCTS if q in p["name"].lower()][:limit]
+    """Return up to `limit` products, best match first.
+
+    Uses fuzzy matching to find products even with typos, missing hyphens/spaces,
+    and reordered words. Exact matches are ranked first.
+    """
+    if not query.strip():
+        return []
+
+    q_lower = query.lower()
+    results = []
+
+    for product in PRODUCTS:
+        name = product["name"].lower()
+
+        # Boost exact substring match to ensure it ranks first
+        if q_lower in name:
+            score = 200
+        else:
+            # token_set_ratio: tokenizes, sorts independently, compares
+            # Handles word reordering, missing spaces/hyphens, typos (1-2 per word)
+            score = fuzz.token_set_ratio(q_lower, name)
+
+        if score >= 60:  # ponytail: threshold for relevance; lower if too strict
+            results.append((score, product))
+
+    results.sort(key=lambda x: -x[0])
+    return [p for _, p in results[:limit]]
