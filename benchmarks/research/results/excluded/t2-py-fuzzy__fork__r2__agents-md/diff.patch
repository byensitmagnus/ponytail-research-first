@@ -5,8 +5,62 @@ from catalog.search import search
 
 class SearchTest(unittest.TestCase):
     def test_exact_substring(self):
+        """Existing test: exact substring match works."""
         self.assertIn("ThinkPad X1 Carbon", search("thinkpad x1 carbon")[0]["name"])
 
+    def test_exact_match_ranks_first(self):
+        """Correctly spelled queries rank exact product first."""
+        result = search("ThinkPad T14 Gen 5")
+        self.assertIn("ThinkPad T14 Gen 5", result[0]["name"])
+
+    def test_misspelled_lenovo_thinkpad(self):
+        """Handle typos: lenvo->lenovo, thinkpd->thinkpad, x1, carbn->carbon."""
+        results = search("lenvo thinkpd x1 carbn", limit=3)
+        # Should find Lenovo ThinkPad X1 Carbon in top 3
+        names = [r["name"] for r in results]
+        found = any("ThinkPad X1 Carbon" in name for name in names)
+        self.assertTrue(found, f"Expected Lenovo ThinkPad X1 Carbon in top 3, got {names}")
+
+    def test_misspelled_samsung_galaxy(self):
+        """Handle typos: samsng->samsung, galxy->galaxy."""
+        results = search("samsng galxy s24 ultra", limit=3)
+        names = [r["name"] for r in results]
+        found = any("Samsung Galaxy S24 Ultra" in name for name in names)
+        self.assertTrue(found, f"Expected Samsung Galaxy S24 Ultra in top 3, got {names}")
+
+    def test_missing_hyphens_sony(self):
+        """Handle missing hyphens: wh1000xm5 -> WH-1000XM5."""
+        results = search("sony wh1000xm5", limit=3)
+        names = [r["name"] for r in results]
+        found = any("WH-1000XM5" in name for name in names)
+        self.assertTrue(found, f"Expected Sony WH-1000XM5 in top 3, got {names}")
+
+    def test_empty_query(self):
+        """Empty or whitespace-only query returns empty list."""
+        self.assertEqual(search(""), [])
+        self.assertEqual(search("   "), [])
+
+    def test_limit_respected(self):
+        """Limit parameter is respected."""
+        results = search("lenovo", limit=5)
+        self.assertLessEqual(len(results), 5)
+
+        results = search("lenovo", limit=1)
+        self.assertEqual(len(results), 1)
+
+    def test_returns_dict_list(self):
+        """Returns list of product dicts with expected keys."""
+        results = search("thinkpad")
+        self.assertIsInstance(results, list)
+        if results:
+            product = results[0]
+            self.assertIsInstance(product, dict)
+            self.assertIn("id", product)
+            self.assertIn("name", product)
+            self.assertIn("brand", product)
+            self.assertIn("category", product)
+            self.assertIn("condition", product)
+
 
 if __name__ == "__main__":
     unittest.main()
