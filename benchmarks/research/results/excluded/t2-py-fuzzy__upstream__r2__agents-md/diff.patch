     def test_exact_substring(self):
         self.assertIn("ThinkPad X1 Carbon", search("thinkpad x1 carbon")[0]["name"])
 
+    def test_typo_single_letter_missing(self):
+        """lenvo (missing 'o') should find Lenovo"""
+        results = search("lenvo thinkpad x1 carbon")
+        self.assertTrue(len(results) > 0)
+        self.assertIn("Lenovo", results[0]["name"])
+
+    def test_typo_swapped_letters(self):
+        """smasung should find Samsung"""
+        results = search("smasung galaxy")
+        self.assertTrue(len(results) > 0)
+        self.assertIn("Samsung", results[0]["name"])
+
+    def test_typo_extra_letter(self):
+        """sonny should find Sony"""
+        results = search("sonny wh1000xm5")
+        self.assertTrue(len(results) > 0)
+        self.assertIn("Sony", results[0]["name"])
+
+    def test_missing_hyphen(self):
+        """wh1000xm5 (no hyphens) should find WH-1000XM5"""
+        results = search("sony wh1000xm5")
+        self.assertTrue(len(results) > 0)
+        self.assertIn("WH-1000XM5", results[0]["name"])
+
+    def test_word_order_change(self):
+        """Words in different order should still match"""
+        results = search("carbon x1 thinkpad")
+        self.assertTrue(len(results) > 0)
+        self.assertIn("ThinkPad X1 Carbon", results[0]["name"])
+
+    def test_multiple_typos(self):
+        """Multiple typos in one query"""
+        results = search("lenvo thinkpd x1 carbn")
+        self.assertTrue(len(results) > 0)
+        self.assertIn("Lenovo", results[0]["name"])
+        self.assertIn("ThinkPad", results[0]["name"])
+
+    def test_limit(self):
+        """Respect the limit parameter"""
+        results = search("lenovo", limit=3)
+        self.assertLessEqual(len(results), 3)
+
+    def test_empty_query(self):
+        """Empty query should return results (partial matches)"""
+        results = search("", limit=5)
+        self.assertLessEqual(len(results), 5)
+
+    def test_exact_match_ranks_first(self):
+        """Exact product name should rank first"""
+        results = search("Lenovo ThinkPad X1 Carbon Gen 11 16GB 512GB SSD Black")
