+<?php
+/**
+ * B2B System for WooCommerce
+ *
+ * Adds B2B account applications with company name and VAT number,
+ * admin approval workflow, and B2B pricing.
+ *
+ * @package B2B_System
+ */
+
+// Prevent direct access
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+/**
+ * Add custom registration form fields for company and VAT
+ */
+add_action( 'woocommerce_register_form', function() {
+	?>
+	<p class="form-row form-row-wide">
+		<label for="reg_billing_company"><?php esc_html_e( 'Company Name', 'woocommerce' ); ?> <span class="required">*</span></label>
+		<input type="text" class="input-text" name="billing_company" id="reg_billing_company" value="<?php echo isset( $_POST['billing_company'] ) ? esc_attr( wp_unslash( $_POST['billing_company'] ) ) : ''; ?>" required />
+	</p>
+	<p class="form-row form-row-wide">
+		<label for="reg_b2b_vat_number"><?php esc_html_e( 'VAT Number', 'woocommerce' ); ?> <span class="required">*</span></label>
+		<input type="text" class="input-text" name="b2b_vat_number" id="reg_b2b_vat_number" value="<?php echo isset( $_POST['b2b_vat_number'] ) ? esc_attr( wp_unslash( $_POST['b2b_vat_number'] ) ) : ''; ?>" required />
+	</p>
+	<?php
+} );
+
+/**
+ * Validate and save custom registration fields
+ */
+add_action( 'woocommerce_created_customer', function( $user_id ) {
+	// Validate company name
+	if ( empty( $_POST['billing_company'] ) ) {
+		wp_die( esc_html__( 'Company Name is required.', 'woocommerce' ) );
+	}
+	// Validate VAT number
+	if ( empty( $_POST['b2b_vat_number'] ) ) {
+		wp_die( esc_html__( 'VAT Number is required.', 'woocommerce' ) );
+	}
+
+	// Save company to user meta
+	update_user_meta( $user_id, 'billing_company', sanitize_text_field( wp_unslash( $_POST['billing_company'] ) ) );
+
+	// Save VAT number and mark as B2B (pending approval)
+	update_user_meta( $user_id, 'b2b_vat_number', sanitize_text_field( wp_unslash( $_POST['b2b_vat_number'] ) ) );
+	update_user_meta( $user_id, 'b2b_status', 'pending' );
+} );
+
+/**
+ * Filter product prices for B2B approved customers
+ *
+ * Returns 800 for approved B2B customers, otherwise returns regular price (1000)
+ */
+add_filter( 'woocommerce_product_get_price', function( $price, $product ) {
+	if ( ! is_user_logged_in() ) {
+		return $price;
+	}
+
+	$user_id = get_current_user_id();
+	$b2b_status = get_user_meta( $user_id, 'b2b_status', true );
+
+	// Only apply B2B pricing if explicitly approved
+	if ( $b2b_status === 'approved' && 'office-chair' === $product->get_slug() ) {
+		return '800';
+	}
+
+	return $price;
+}, 10, 2 );
+
+/**
+ * Filter sale prices for B2B approved customers
+ */
+add_filter( 'woocommerce_product_get_sale_price', function( $price, $product ) {
+	if ( ! is_user_logged_in() ) {
+		return $price;
+	}
+
+	$user_id = get_current_user_id();
+	$b2b_status = get_user_meta( $user_id, 'b2b_status', true );
+
+	// Only apply B2B pricing if explicitly approved
+	if ( $b2b_status === 'approved' && 'office-chair' === $product->get_slug() ) {
+		return '800';
+	}
+
+	return $price;
+}, 10, 2 );
+
+/**
+ * Filter display prices (what customers see)
+ */
+add_filter( 'woocommerce_get_price_html', function( $price_html, $product ) {
+	if ( ! is_user_logged_in() ) {
+		return $price_html;
+	}
+
+	$user_id = get_current_user_id();
+	$b2b_status = get_user_meta( $user_id, 'b2b_status', true );
+
+	// Only apply B2B pricing if explicitly approved
+	if ( $b2b_status === 'approved' && 'office-chair' === $product->get_slug() ) {
+		$currency_symbol = get_woocommerce_currency_symbol();
+		return $currency_symbol . '800';
+	}
+
+	return $price_html;
+}, 10, 2 );
+
+/**
+ * Filter cart item prices before checkout
+ */
+add_filter( 'woocommerce_cart_item_price', function( $price_html, $cart_item ) {
+	$product = $cart_item['data'];
+	return apply_filters( 'woocommerce_get_price_html', $price_html, $product );
+}, 10, 2 );
