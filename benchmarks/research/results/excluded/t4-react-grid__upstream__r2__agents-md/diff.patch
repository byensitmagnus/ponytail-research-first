 import type { Order } from './types.ts';
+import ExcelJS from 'exceljs';
 
-// See TASK.md for the required behaviour.
 export async function exportGroupedXlsx(rows: Order[], groupBy: 'customer'): Promise<Uint8Array> {
-  throw new Error('not implemented');
+  const workbook = new ExcelJS.Workbook();
+  const sheet = workbook.addWorksheet('Orders');
+
+  // Add headers
+  sheet.columns = [
+    { header: 'Order', key: 'id' },
+    { header: 'Date', key: 'date' },
+    { header: 'Customer', key: 'customer' },
+    { header: 'Product', key: 'product' },
+    { header: 'Qty', key: 'qty' },
+    { header: 'Unit price', key: 'unitPrice' },
+    { header: 'Amount', key: 'amount' },
+  ];
+
+  // Group by customer
+  const groups: Record<string, Order[]> = {};
+  for (const order of rows) {
+    if (!groups[order.customer]) {
+      groups[order.customer] = [];
+    }
+    groups[order.customer].push(order);
+  }
+
+  // Add grouped data with subtotals
+  for (const [customer, customerOrders] of Object.entries(groups)) {
+    // Add customer header
+    const headerRow = sheet.addRow({ customer });
+    headerRow.font = { bold: true };
+    headerRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD3D3D3' } };
+
+    // Add order rows
+    let totalQty = 0;
+    let totalAmount = 0;
+    for (const order of customerOrders) {
+      const amount = order.qty * order.unitPrice;
+      totalQty += order.qty;
+      totalAmount += amount;
+      sheet.addRow({
+        id: order.id,
+        date: order.date,
+        customer: order.customer,
+        product: order.product,
+        qty: order.qty,
+        unitPrice: order.unitPrice,
+        amount,
+      });
+    }
+
+    // Add subtotal row
+    const subtotalRow = sheet.addRow({
+      customer: `Subtotal for ${customer}`,
+      qty: totalQty,
+      amount: totalAmount,
+    });
+    subtotalRow.font = { bold: true };
+    subtotalRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF5F5F5' } };
+
+    // Empty row for spacing
+    sheet.addRow({});
+  }
+
+  // Format columns
+  sheet.columns.forEach((column) => {
+    column.width = 15;
+  });
+  sheet.getColumn('product').width = 20;
+
+  // Format number columns
+  for (let row = 2; row <= sheet.rowCount; row++) {
+    const qtyCell = sheet.getCell(row, 5);
+    const unitPriceCell = sheet.getCell(row, 6);
+    const amountCell = sheet.getCell(row, 7);
+
+    if (qtyCell.value !== null && typeof qtyCell.value === 'number') {
+      qtyCell.numFmt = '0';
+    }
+    if (unitPriceCell.value !== null && typeof unitPriceCell.value === 'number') {
+      unitPriceCell.numFmt = '0.00';
+    }
+    if (amountCell.value !== null && typeof amountCell.value === 'number') {
+      amountCell.numFmt = '0.00';
+    }
+  }
+
+  // Write to buffer
+  const buffer = await workbook.xlsx.writeBuffer();
+  return new Uint8Array(buffer);
 }
