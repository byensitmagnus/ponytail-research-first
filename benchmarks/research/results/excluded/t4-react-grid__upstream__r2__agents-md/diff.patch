-          <th>Order</th>
-          <th>Date</th>
-          <th>Customer</th>
-          <th>Product</th>
-          <th>Qty</th>
-          <th>Unit price</th>
-          <th>Amount</th>
-        </tr>
-      </thead>
-      <tbody>
-        {rows.map((o) => (
-          <tr key={o.id}>
-            <td>{o.id}</td>
-            <td>{o.date}</td>
-            <td>{o.customer}</td>
-            <td>{o.product}</td>
-            <td>{o.qty}</td>
-            <td>{o.unitPrice.toFixed(2)}</td>
-            <td>{(o.qty * o.unitPrice).toFixed(2)}</td>
+    <div>
+      <div style={{ marginBottom: '1em', display: 'flex', gap: '1em', alignItems: 'center' }}>
+        <input
+          type="text"
+          placeholder="Search by Order, Date, Customer, or Product"
+          value={search}
+          onChange={(e) => {
+            setSearch(e.target.value);
+            setPage(0);
+          }}
+          style={{ flex: 1, padding: '0.5em' }}
+        />
+        <button onClick={handleExport} style={{ padding: '0.5em 1em' }}>
+          Export to Excel
+        </button>
+      </div>
+
+      <table style={{ width: '100%', borderCollapse: 'collapse' }}>
+        <thead>
+          <tr>
+            <SortHeader label="Order" key="id" />
+            <SortHeader label="Date" key="date" />
+            <SortHeader label="Customer" key="customer" />
+            <SortHeader label="Product" key="product" />
+            <SortHeader label="Qty" key="qty" />
+            <SortHeader label="Unit price" key="unitPrice" />
+            <SortHeader label="Amount" key="amount" />
           </tr>
-        ))}
-      </tbody>
-    </table>
+        </thead>
+        <tbody>
+          {paginatedGroups.map(([customer, orders]) => {
+            const totalQty = orders.reduce((sum, o) => sum + o.qty, 0);
+            const totalAmount = orders.reduce((sum, o) => sum + o.qty * o.unitPrice, 0);
+            return (
+              <tbody key={customer}>
+                {orders.map((o) => (
+                  <tr key={o.id} style={{ borderBottom: '1px solid #ddd' }}>
+                    <td>{o.id}</td>
+                    <td>{o.date}</td>
+                    <td>{o.customer}</td>
+                    <td>{o.product}</td>
+                    <td>{o.qty}</td>
+                    <td>{o.unitPrice.toFixed(2)}</td>
+                    <td>{(o.qty * o.unitPrice).toFixed(2)}</td>
+                  </tr>
+                ))}
+                <tr style={{ backgroundColor: '#f5f5f5', fontWeight: 'bold' }}>
+                  <td colSpan={4}>Subtotal for {customer}</td>
+                  <td>{totalQty}</td>
+                  <td></td>
+                  <td>{totalAmount.toFixed(2)}</td>
+                </tr>
+              </tbody>
+            );
+          })}
+        </tbody>
+      </table>
+
+      <div style={{ marginTop: '1em', display: 'flex', gap: '0.5em', justifyContent: 'center' }}>
+        <button onClick={() => setPage(Math.max(0, page - 1))} disabled={page === 0}>
+          Previous
+        </button>
+        <span>
+          Page {page + 1} of {totalPages} ({grouped.length} customer groups)
+        </span>
+        <button onClick={() => setPage(Math.min(totalPages - 1, page + 1))} disabled={page >= totalPages - 1}>
+          Next
+        </button>
+      </div>
+    </div>
   );
 }
