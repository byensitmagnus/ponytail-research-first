+'use client';
+
+import { useState, useMemo } from 'react';
 import type { Order } from './types.ts';
+import { exportGroupedXlsx } from './exportXlsx.ts';
+
+type SortKey = 'id' | 'date' | 'customer' | 'product' | 'qty' | 'unitPrice' | 'amount';
 
 export function OrdersTable({ rows }: { rows: Order[] }) {
+  const [search, setSearch] = useState('');
+  const [sortKey, setSortKey] = useState<SortKey>('id');
+  const [sortAsc, setSortAsc] = useState(true);
+  const [page, setPage] = useState(0);
+  const PAGE_SIZE = 25;
+
+  // Filter rows by search text
+  const filtered = useMemo(() => {
+    if (!search.trim()) return rows;
+    const q = search.toLowerCase();
+    return rows.filter(
+      (r) =>
+        r.id.toLowerCase().includes(q) ||
+        r.date.toLowerCase().includes(q) ||
+        r.customer.toLowerCase().includes(q) ||
+        r.product.toLowerCase().includes(q)
+    );
+  }, [rows, search]);
+
+  // Sort rows
+  const sorted = useMemo(() => {
+    const copy = [...filtered];
+    copy.sort((a, b) => {
+      let aVal: any;
+      let bVal: any;
+      // Special case: amount is calculated
+      if (sortKey === 'amount') {
+        aVal = a.qty * a.unitPrice;
+        bVal = b.qty * b.unitPrice;
+      } else {
+        aVal = a[sortKey as keyof Order];
+        bVal = b[sortKey as keyof Order];
+      }
+      if (aVal < bVal) return sortAsc ? -1 : 1;
+      if (aVal > bVal) return sortAsc ? 1 : -1;
+      return 0;
+    });
+    return copy;
+  }, [filtered, sortKey, sortAsc]);
+
+  // Group by customer and paginate
+  const grouped = useMemo(() => {
+    const groups: Record<string, Order[]> = {};
+    for (const order of sorted) {
+      if (!groups[order.customer]) {
+        groups[order.customer] = [];
+      }
+      groups[order.customer].push(order);
+    }
+    return Object.entries(groups);
+  }, [sorted]);
+
+  // Paginate the grouped results
+  const start = page * PAGE_SIZE;
+  const paginatedGroups = grouped.slice(start, start + PAGE_SIZE);
+  const totalPages = Math.ceil(grouped.length / PAGE_SIZE);
+
+  const handleSort = (key: SortKey) => {
+    if (sortKey === key) {
+      setSortAsc(!sortAsc);
+    } else {
+      setSortKey(key);
+      setSortAsc(true);
+    }
+  };
+
+  const handleExport = async () => {
+    try {
+      const xlsx = await exportGroupedXlsx(sorted, 'customer');
+      const blob = new Blob([xlsx as any], {
+        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+      });
+      const url = URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      a.href = url;
+      a.download = 'orders.xlsx';
+      a.click();
+      URL.revokeObjectURL(url);
+    } catch (err) {
+      console.error('Export failed:', err);
+      alert('Failed to export: ' + (err instanceof Error ? err.message : String(err)));
+    }
+  };
+
+  const SortHeader = ({ label, key }: { label: string; key: SortKey }) => (
+    <th onClick={() => handleSort(key)} style={{ cursor: 'pointer', userSelect: 'none' }}>
+      {label} {sortKey === key && (sortAsc ? '↑' : '↓')}
+    </th>
+  );
+
   return (
-    <table>
