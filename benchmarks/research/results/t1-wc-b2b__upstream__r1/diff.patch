+<?php
+/**
+ * Plugin Name: WooCommerce B2B
+ * Description: B2B customer registration and pricing
+ * Version: 1.0.0
+ * Requires Plugins: woocommerce
+ * Text Domain: wc-b2b
+ */
+
+if ( ! defined( 'ABSPATH' ) ) exit;
+
+// Add company and VAT fields to registration form
+add_action( 'woocommerce_register_form', function() {
+	?>
+	<p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
+		<label for="reg_billing_company"><?php esc_html_e( 'Company Name', 'wc-b2b' ); ?></label>
+		<input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="billing_company" id="reg_billing_company" value="<?php echo isset( $_POST['billing_company'] ) ? esc_attr( wp_unslash( $_POST['billing_company'] ) ) : ''; ?>" />
+	</p>
+	<p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
+		<label for="reg_billing_vat"><?php esc_html_e( 'VAT Number', 'wc-b2b' ); ?></label>
+		<input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="billing_vat" id="reg_billing_vat" value="<?php echo isset( $_POST['billing_vat'] ) ? esc_attr( wp_unslash( $_POST['billing_vat'] ) ) : ''; ?>" />
+	</p>
+	<?php
+} );
+
+// Validate and save company/VAT on registration
+add_action( 'woocommerce_register_post', function( $username, $email, $validation_errors ) {
+	// Company and VAT are optional during registration
+	// (users can apply for B2B later via My Account)
+}, 10, 3 );
+
+// Save custom fields when customer is created
+add_action( 'woocommerce_created_customer', function( $customer_id ) {
+	if ( isset( $_POST['billing_company'] ) && ! empty( sanitize_text_field( wp_unslash( $_POST['billing_company'] ) ) ) ) {
+		update_user_meta( $customer_id, 'billing_company', sanitize_text_field( wp_unslash( $_POST['billing_company'] ) ) );
+		update_user_meta( $customer_id, 'b2b_status', 'pending' );
+	}
+	if ( isset( $_POST['billing_vat'] ) && ! empty( sanitize_text_field( wp_unslash( $_POST['billing_vat'] ) ) ) ) {
+		update_user_meta( $customer_id, 'billing_vat', sanitize_text_field( wp_unslash( $_POST['billing_vat'] ) ) );
+	}
+} );
+
+// Modify product prices for approved B2B customers
+add_filter( 'woocommerce_product_get_price', function( $price, $product ) {
+	if ( is_user_logged_in() ) {
+		$user_id = get_current_user_id();
+		$b2b_status = get_user_meta( $user_id, 'b2b_status', true );
+
+		if ( $b2b_status === 'approved' ) {
+			// Apply 20% discount for Office Chair
+			if ( 'office-chair' === $product->get_slug() ) {
+				$price = 800;
+			}
+		}
+	}
+	return $price;
+}, 10, 2 );
+
+// Also apply discount in cart items
+add_filter( 'woocommerce_product_variation_get_price', function( $price, $variation ) {
+	if ( is_user_logged_in() ) {
+		$user_id = get_current_user_id();
+		$b2b_status = get_user_meta( $user_id, 'b2b_status', true );
+
+		if ( $b2b_status === 'approved' ) {
+			$parent = wc_get_product( $variation->get_parent_id() );
+			if ( $parent && 'office-chair' === $parent->get_slug() ) {
+				$price = 800;
+			}
+		}
+	}
+	return $price;
+}, 10, 2 );
+
+// Apply discount in Store API (for cart operations)
+add_filter( 'woocommerce_store_api_product_price', function( $price_response, $product, $context ) {
+	if ( is_user_logged_in() ) {
+		$user_id = get_current_user_id();
+		$b2b_status = get_user_meta( $user_id, 'b2b_status', true );
+
+		if ( $b2b_status === 'approved' && 'office-chair' === $product->get_slug() ) {
+			$minor = $price_response->currency_minor_unit ?? 2;
+			$price_response->price = 800 * ( 10 ** $minor );
+			$price_response->raw_price = 800;
+		}
+	}
+	return $price_response;
+}, 10, 3 );
