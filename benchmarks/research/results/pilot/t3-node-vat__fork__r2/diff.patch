diff --git a/src/vat.js b/src/vat.js
index 4179a6d..a264cc1 100644
--- a/src/vat.js
+++ b/src/vat.js
@@ -1,4 +1,72 @@
-// VAT number check used by the B2B checkout. See TASK.md.
+// Formats from the Irish Revenue VIES Traders Manual, section 4.8.
+const formats = {
+  AT: /^U\d{8}$/, BE: /^\d{10}$/, BG: /^\d{9,10}$/, HR: /^\d{11}$/,
+  CY: /^\d{8}[A-Z]$/, CZ: /^\d{8,10}$/, DK: /^\d{8}$/, EE: /^\d{9}$/,
+  FI: /^\d{8}$/, FR: /^[A-Z0-9]{2}\d{9}$/, DE: /^\d{9}$/, EL: /^\d{9}$/,
+  HU: /^\d{8}$/, IE: /^(?:\d{7}[A-Z]{1,2}|\d[A-Z]\d{5}[A-Z])$/,
+  IT: /^\d{11}$/, LV: /^\d{11}$/, LT: /^(?:\d{9}|\d{12})$/,
+  LU: /^\d{8}$/, MT: /^\d{8}$/, NL: /^\d{9}B\d{2}$/,
+  PL: /^\d{10}$/, PT: /^\d{9}$/, RO: /^\d{2,10}$/, SK: /^\d{10}$/,
+  SI: /^\d{8}$/, ES: /^(?:[A-Z]\d{8}|\d{8}[A-Z]|[A-Z]\d{7}[A-Z])$/,
+  SE: /^\d{12}$/, XI: /^(?:\d{9}|\d{12})$/,
+};
+
+const endpoint = 'https://ec.europa.eu/taxation_customs/vies/rest-api/ms';
+
 export async function checkVat(input, options = {}) {
-  throw new Error('not implemented');
+  const normalized = typeof input === 'string'
+    ? input.replace(/[ .-]/g, '').toUpperCase()
+    : '';
+  const countryCode = normalized.slice(0, 2);
+  const vatNumber = normalized.slice(2);
+
+  if (!formats[countryCode]?.test(vatNumber)) {
+    return { status: 'malformed', valid: false };
+  }
+
+  const identity = { countryCode, vatNumber };
+  const controller = new AbortController();
+  let timer;
+  try {
+    const response = await Promise.race([
+      (async () => {
+        const res = await (options.fetch ?? globalThis.fetch)(
+          `${endpoint}/${countryCode}/vat/${vatNumber}`,
+          { signal: controller.signal },
+        );
+        if (!res.ok) throw new Error(`VIES HTTP ${res.status}`);
+        return res.json();
+      })(),
+      new Promise((_, reject) => {
+        timer = setTimeout(() => {
+          controller.abort();
+          reject(new Error('VIES timed out after 10 seconds'));
+        }, 10_000);
+      }),
+    ]);
+
+    if ((!response?.userError || response.userError === 'VALID') && response?.isValid === true) {
+      const result = { status: 'valid', valid: true, ...identity };
+      for (const field of ['name', 'address']) {
+        if (typeof response[field] === 'string' && response[field].trim() && response[field].trim() !== '---') {
+          result[field] = response[field].trim();
+        }
+      }
+      return result;
+    }
+    if ((!response?.userError || response.userError === 'INVALID') && response?.isValid === false) {
+      return { status: 'invalid', valid: false, ...identity };
+    }
+    return {
+      status: 'unverified', valid: null, ...identity,
+      reason: response?.userError || 'Unexpected VIES response',
+    };
+  } catch (error) {
+    return {
+      status: 'unverified', valid: null, ...identity,
+      reason: error instanceof Error ? error.message : 'VIES request failed',
+    };
+  } finally {
+    clearTimeout(timer);
+  }
 }
diff --git a/test/vat.test.js b/test/vat.test.js
index 6d374d9..58faa4b 100644
--- a/test/vat.test.js
+++ b/test/vat.test.js
@@ -5,3 +5,83 @@ import { checkVat } from '../src/vat.js';
 test('checkVat is exported', () => {
   assert.equal(typeof checkVat, 'function');
 });
+
+const ok = (data) => ({ ok: true, json: async () => data });
+
+test('normalizes input and returns VIES registration details', async () => {
+  let requested;
+  const result = await checkVat('dk 12.34-56 78', {
+    fetch: async (url, init) => {
+      requested = { url, init };
+      return ok({ isValid: true, userError: 'VALID', name: 'Example ApS', address: 'Main St 1' });
+    },
+  });
+  assert.deepEqual(result, {
+    status: 'valid', valid: true, countryCode: 'DK', vatNumber: '12345678',
+    name: 'Example ApS', address: 'Main St 1',
+  });
+  assert.equal(requested.url, 'https://ec.europa.eu/taxation_customs/vies/rest-api/ms/DK/vat/12345678');
+  assert.ok(requested.init.signal instanceof AbortSignal);
+});
+
+test('accepts all EU member states and Northern Ireland without a network call for malformed input', async () => {
+  const examples = [
+    'ATU12345678', 'BE0123456789', 'BG123456789', 'HR23456789012',
+    'CY12345678M', 'CZ12345678', 'DK12345678', 'EE123456789',
+    'FI12345678', 'FRAB123456789', 'DE129273398', 'EL123456789',
+    'HU12345678', 'IE1Z23456A', 'IT12345678912', 'LV12345678912',
+    'LT123456789', 'LU12345678', 'MT12345678', 'NL123456789B12',
+    'PL1234567891', 'PT123456789', 'RO12', 'SK1234567891',
+    'SI12345678', 'ESA12345678', 'SE123456789123', 'XI123456789001',
+  ];
+  let calls = 0;
+  const fetch = async () => { calls++; return ok({ isValid: false, userError: 'INVALID' }); };
+  for (const example of examples) {
+    assert.equal((await checkVat(example, { fetch })).status, 'invalid', example);
+  }
+  assert.equal(calls, examples.length);
+
+  for (const bad of ['GB123456789', 'GR123456789', 'DK123', 'DE12A45678', 'NL123456789C12', 'XI123', '', null, 123]) {
+    assert.deepEqual(await checkVat(bad, { fetch }), { status: 'malformed', valid: false }, String(bad));
+  }
+  assert.equal(calls, examples.length);
+});
+
+test('distinguishes invalid registrations from VIES failures', async () => {
+  const input = 'DE129273398';
+  const identity = { countryCode: 'DE', vatNumber: '129273398' };
+  assert.deepEqual(await checkVat(input, { fetch: async () => ok({ isValid: false, userError: 'INVALID' }) }),
+    { status: 'invalid', valid: false, ...identity });
+  assert.deepEqual(await checkVat(input, { fetch: async () => ok({ isValid: false, userError: 'MS_UNAVAILABLE' }) }),
+    { status: 'unverified', valid: null, ...identity, reason: 'MS_UNAVAILABLE' });
+  assert.deepEqual(await checkVat(input, { fetch: async () => ({ ok: false, status: 503 }) }),
+    { status: 'unverified', valid: null, ...identity, reason: 'VIES HTTP 503' });
+  assert.deepEqual(await checkVat(input, { fetch: async () => { throw new Error('offline'); } }),
+    { status: 'unverified', valid: null, ...identity, reason: 'offline' });
+});
+
+test('omits VIES placeholders and survives malformed response data', async () => {
+  const fetch = async () => ok({ isValid: true, userError: 'VALID', name: '---', address: '  ' });
+  assert.deepEqual(await checkVat('de129273398', { fetch }), {
+    status: 'valid', valid: true, countryCode: 'DE', vatNumber: '129273398',
+  });
+  assert.equal((await checkVat('de129273398', { fetch: async () => ok({ isValid: false }) })).status, 'invalid');
+  assert.equal((await checkVat('de129273398', { fetch: async () => ok({}) })).status, 'unverified');
+});
+
+test('times out even when fetch ignores abort', async (t) => {
+  t.mock.timers.enable({ apis: ['setTimeout'] });
+  let signal;
+  const pending = checkVat('DK12345678', {
+    fetch: async (_url, init) => {
+      signal = init.signal;
+      return new Promise(() => {});
+    },
+  });
+  t.mock.timers.tick(10_000);
+  assert.deepEqual(await pending, {
+    status: 'unverified', valid: null, countryCode: 'DK', vatNumber: '12345678',
+    reason: 'VIES timed out after 10 seconds',
+  });
+  assert.equal(signal.aborted, true);
+});
