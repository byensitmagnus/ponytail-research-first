 // VAT number check used by the B2B checkout. See TASK.md.
+
+// VAT format patterns per country (number part only, after country code)
+const vatFormats = {
+  AT: /^\d{8}$/, // Austria
+  BE: /^\d{10}$/, // Belgium
+  BG: /^\d{9,10}$/, // Bulgaria
+  HR: /^\d{11}$/, // Croatia
+  CY: /^\d{8}[A-Z]$/, // Cyprus
+  CZ: /^\d{8,10}$/, // Czech Republic
+  DK: /^\d{8}$/, // Denmark
+  EE: /^\d{9}$/, // Estonia
+  EL: /^\d{9}$/, // Greece
+  ES: /^[A-Z]\d{7}[A-Z0-9]$/, // Spain
+  FI: /^\d{8}$/, // Finland
+  FR: /^[A-Z0-9]{2}\d{9}$/, // France
+  DE: /^\d{11}$/, // Germany
+  HU: /^\d{8}$/, // Hungary
+  IE: /^\d{7}[A-Z]$|^\d{8}$/, // Ireland (old or new)
+  IT: /^\d{11}$/, // Italy
+  LV: /^\d{11}$/, // Latvia
+  LT: /^\d{12}$/, // Lithuania
+  LU: /^\d{8}$/, // Luxembourg
+  MT: /^\d{8}$/, // Malta
+  NL: /^\d{12}$/, // Netherlands
+  PL: /^\d{10}$/, // Poland
+  PT: /^\d{9}$/, // Portugal
+  RO: /^\d{6,10}$/, // Romania
+  SK: /^\d{10}$/, // Slovakia
+  SI: /^\d{8}$/, // Slovenia
+  SE: /^\d{12}$/, // Sweden
+  XI: /^\d{12}$/, // Northern Ireland (GB format)
+};
+
+async function verifyViaVies(countryCode, vatNumber, fetchImpl) {
+  // [rules]: SOAP request over HTTP; upgrade if VIES provides direct HTTP API
+  const url = 'https://ec.europa.eu/taxation_customs/vies/services/checkVatService';
+
+  const soapBody = `<?xml version="1.0" encoding="UTF-8"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tns="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+  <soap:Body>
+    <tns:checkVat>
+      <tns:vatNumber>${escapeXml(vatNumber)}</tns:vatNumber>
+      <tns:countryCode>${escapeXml(countryCode)}</tns:countryCode>
+    </tns:checkVat>
+  </soap:Body>
+</soap:Envelope>`;
+
+  const controller = new AbortController();
+  const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout
+
+  try {
+    const response = await fetchImpl(url, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'text/xml; charset=UTF-8',
+        'SOAPAction': '',
+      },
+      body: soapBody,
+      signal: controller.signal,
+    });
+
+    if (!response.ok) {
+      throw new Error(`VIES service returned ${response.status}`);
+    }
+
+    const text = await response.text();
+    const result = parseSoapResponse(text);
+
+    return {
+      status: result.valid ? 'valid' : 'invalid',
+      valid: result.valid,
+      countryCode,
+      vatNumber,
+      name: result.name || undefined,
+      address: result.address || undefined,
+    };
+  } catch (error) {
+    if (error.name === 'AbortError') {
+      throw new Error('VIES service timeout');
+    }
+    if (error instanceof TypeError) {
+      throw new Error('VIES service unavailable');
+    }
+    throw error;
+  } finally {
+    clearTimeout(timeoutId);
+  }
+}
+
+function escapeXml(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function parseSoapResponse(soapXml) {
+  // Extract valid, name, address from SOAP response
+  // [rules]: simple string extraction, not full XML parser (no dep)
+
+  // Check for fault
+  if (soapXml.includes('<soap:Fault>') || soapXml.includes('<faultstring>')) {
+    const faultMatch = soapXml.match(/<faultstring>([^<]+)<\/faultstring>/);
+    if (faultMatch && faultMatch[1].includes('invalid')) {
+      return { valid: false };
+    }
+    throw new Error('VIES service error');
+  }
+
+  // Extract valid
+  const validMatch = soapXml.match(/<ns\d+:valid>([^<]+)<\/ns\d+:valid>/);
+  const valid = validMatch ? validMatch[1].toLowerCase() === 'true' : false;
+
+  // Extract name and address
+  const nameMatch = soapXml.match(/<ns\d+:name>([^<]*)<\/ns\d+:name>/);
+  const addressMatch = soapXml.match(/<ns\d+:address>([^<]*)<\/ns\d+:address>/);
+
+  return {
+    valid,
+    name: nameMatch ? nameMatch[1].trim() || undefined : undefined,
+    address: addressMatch ? addressMatch[1].trim() || undefined : undefined,
+  };
+}
+
 export async function checkVat(input, options = {}) {
-  throw new Error('not implemented');
+  const fetchImpl = options.fetch || globalThis.fetch;
+
+  // Normalize input: remove spaces, dots, dashes; uppercase
+  const normalized = input
+    .trim()
+    .replace(/[\s.\-]/g, '')
+    .toUpperCase();
+
+  // Extract country code (first 2 chars) and VAT number (rest)
+  if (normalized.length < 3) {
+    return {
+      status: 'malformed',
+      valid: false,
+      reason: 'Input too short',
+    };
+  }
+
+  const countryCode = normalized.slice(0, 2);
+  const vatNumber = normalized.slice(2);
+
+  // Check if country is known
+  if (!vatFormats[countryCode]) {
+    return {
+      status: 'malformed',
+      valid: false,
+      reason: `Unknown country code: ${countryCode}`,
+    };
+  }
+
+  // Check format
+  if (!vatFormats[countryCode].test(vatNumber)) {
+    return {
+      status: 'malformed',
+      valid: false,
+      reason: `Invalid VAT format for ${countryCode}`,
+    };
+  }
+
+  // Well-formed; verify via VIES
+  try {
+    return await verifyViaVies(countryCode, vatNumber, fetchImpl);
+  } catch (error) {
+    return {
+      status: 'unverified',
+      valid: null,
+      countryCode,
+      vatNumber,
+      reason: error.message,
+    };
+  }
 }
