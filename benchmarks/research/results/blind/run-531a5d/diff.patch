@@ -5,3 +5,153 @@ import { checkVat } from '../src/vat.js';
 test('checkVat is exported', () => {
   assert.equal(typeof checkVat, 'function');
 });
+
+test('format: rejects unknown country', async () => {
+  const result = await checkVat('XX12345678');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('format: rejects too-short input', async () => {
+  const result = await checkVat('DK');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('format: rejects invalid DK format', async () => {
+  const result = await checkVat('DK 123');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('format: normalizes spaces and dashes', async () => {
+  // Both should be treated as malformed (wrong length for DK)
+  // but normalization should work
+  const result = await checkVat('DK 12-34-56');
+  assert.equal(result.status, 'malformed');
+});
+
+test('format: accepts case-insensitive input', async () => {
+  // Create a mock fetch that returns valid
+  const mockFetch = async () => ({
+    ok: true,
+    text: async () => `<?xml version="1.0"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+  <soap:Body>
+    <ns0:checkVatResponse xmlns:ns0="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+      <ns0:valid>true</ns0:valid>
+      <ns0:name>Test Company</ns0:name>
+      <ns0:address>Test Address</ns0:address>
+    </ns0:checkVatResponse>
+  </soap:Body>
+</soap:Envelope>`,
+  });
+
+  const result = await checkVat('dk12345678', { fetch: mockFetch });
+  // If it gets to VIES, it means format was accepted (case insensitivity worked)
+  assert.equal(result.status, 'valid');
+  assert.equal(result.valid, true);
+});
+
+test('vies: returns valid when VIES confirms', async () => {
+  const mockFetch = async () => ({
+    ok: true,
+    text: async () => `<?xml version="1.0"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+  <soap:Body>
+    <ns0:checkVatResponse xmlns:ns0="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+      <ns0:valid>true</ns0:valid>
+      <ns0:name>Valid Company A/S</ns0:name>
+      <ns0:address>Main Street 1, Copenhagen</ns0:address>
+    </ns0:checkVatResponse>
+  </soap:Body>
+</soap:Envelope>`,
+  });
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'valid');
+  assert.equal(result.valid, true);
+  assert.equal(result.name, 'Valid Company A/S');
+  assert.equal(result.address, 'Main Street 1, Copenhagen');
+});
+
+test('vies: returns invalid when VIES rejects', async () => {
+  const mockFetch = async () => ({
+    ok: true,
+    text: async () => `<?xml version="1.0"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+  <soap:Body>
+    <ns0:checkVatResponse xmlns:ns0="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+      <ns0:valid>false</ns0:valid>
+    </ns0:checkVatResponse>
+  </soap:Body>
+</soap:Envelope>`,
+  });
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'invalid');
+  assert.equal(result.valid, false);
+});
+
+test('vies: returns unverified on timeout', async () => {
+  const mockFetch = async () => {
+    throw new DOMException('The operation was aborted.', 'AbortError');
+  };
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'unverified');
+  assert.equal(result.valid, null);
+  assert.match(result.reason, /timeout/i);
+});
+
+test('vies: returns unverified on network error', async () => {
+  const mockFetch = async () => {
+    throw new TypeError('Network error');
+  };
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'unverified');
+  assert.equal(result.valid, null);
+});
+
+test('vies: returns unverified on VIES server error', async () => {
+  const mockFetch = async () => ({
+    ok: false,
+    status: 500,
+    text: async () => '',
+  });
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'unverified');
+  assert.equal(result.valid, null);
+});
+
+test('format: accepts various EU countries', async () => {
+  const mockFetch = async () => ({
+    ok: true,
+    text: async () => `<?xml version="1.0"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+  <soap:Body>
+    <ns0:checkVatResponse xmlns:ns0="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+      <ns0:valid>true</ns0:valid>
+    </ns0:checkVatResponse>
+  </soap:Body>
+</soap:Envelope>`,
+  });
+
+  // DE (Germany): 11 digits
+  const de = await checkVat('DE12345678901', { fetch: mockFetch });
+  assert.equal(de.status, 'valid');
+
+  // FR (France): 2 alphanumeric + 9 digits
+  const fr = await checkVat('FRXY123456789', { fetch: mockFetch });
+  assert.equal(fr.status, 'valid');
+
+  // EL (Greece): 9 digits
+  const el = await checkVat('EL123456789', { fetch: mockFetch });
+  assert.equal(el.status, 'valid');
+
+  // XI (Northern Ireland): 12 digits
+  const xi = await checkVat('XI123456789012', { fetch: mockFetch });
+  assert.equal(xi.status, 'valid');
+});
