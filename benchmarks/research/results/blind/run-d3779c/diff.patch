+from rapidfuzz import fuzz
+
 DATA = Path(__file__).resolve().parent.parent / "data" / "products.csv"
 
 with DATA.open(encoding="utf-8") as f:
@@ -9,6 +11,23 @@ with DATA.open(encoding="utf-8") as f:
 
 
 def search(query: str, limit: int = 10) -> list[dict]:
-    """Return up to `limit` products, best match first."""
+    """Return up to `limit` products, best match first.
+
+    Tolerates typos, missing spaces/hyphens, and word reordering using
+    fuzzy token-set matching (Levenshtein distance via rapidfuzz).
+    """
     q = query.lower()
-    return [p for p in PRODUCTS if q in p["name"].lower()][:limit]
+
+    # Score each product using token_set_ratio:
+    # - Handles word order differences
+    # - Handles missing spaces/hyphens (via tokenization)
+    # - Handles typos within words (via fuzzy matching)
+    scores = []
+    for p in PRODUCTS:
+        score = fuzz.token_set_ratio(q, p["name"].lower())
+        if score > 0:
+            scores.append((score, p))
+
+    # Sort by score (descending) and return top results
+    scores.sort(key=lambda x: -x[0])
+    return [p for _, p in scores[:limit]]
