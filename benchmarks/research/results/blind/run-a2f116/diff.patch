@@ -5,3 +5,171 @@ import { checkVat } from '../src/vat.js';
 test('checkVat is exported', () => {
   assert.equal(typeof checkVat, 'function');
 });
+
+test('malformed: missing country code', async () => {
+  const result = await checkVat('12345678');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('malformed: empty input', async () => {
+  const result = await checkVat('');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('malformed: unknown country code', async () => {
+  const result = await checkVat('XX12345678');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('malformed: wrong format for DK (too short)', async () => {
+  const result = await checkVat('DK1234567');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+  assert.equal(result.countryCode, 'DK');
+});
+
+test('malformed: wrong format for DK (letters)', async () => {
+  const result = await checkVat('DKABCDEFGH');
+  assert.equal(result.status, 'malformed');
+  assert.equal(result.valid, false);
+});
+
+test('normalizes: case insensitive', async () => {
+  const mockFetch = async (url, opts) => {
+    const body = opts.body;
+    assert.match(body, /<countryCode>DK<\/countryCode>/);
+    assert.match(body, /<vatNumber>12345678<\/vatNumber>/);
+    return new Response(`<checkVatResponse><valid>true</valid></checkVatResponse>`, {
+      status: 200
+    });
+  };
+
+  const result = await checkVat('dk12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'valid');
+  assert.equal(result.valid, true);
+});
+
+test('normalizes: removes spaces, dashes, dots', async () => {
+  const mockFetch = async (url, opts) => {
+    assert.match(opts.body, /<vatNumber>12345678<\/vatNumber>/);
+    return new Response(`<checkVatResponse><valid>false</valid></checkVatResponse>`, {
+      status: 200
+    });
+  };
+
+  const result = await checkVat('DK 12.34-56.78', { fetch: mockFetch });
+  assert.equal(result.status, 'invalid');
+  assert.equal(result.valid, false);
+});
+
+test('vies: valid response with name and address', async () => {
+  const mockFetch = async () => {
+    return new Response(`
+      <checkVatResponse>
+        <valid>true</valid>
+        <name>Test Company A/S</name>
+        <address>Main Street 123, Copenhagen, DK</address>
+      </checkVatResponse>
