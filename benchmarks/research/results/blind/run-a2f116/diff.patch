+  assert.equal(result.valid, true);
+  assert.equal(result.name, 'Test Company A/S');
+  assert.equal(result.address, 'Main Street 123, Copenhagen, DK');
+});
+
+test('vies: invalid response', async () => {
+  const mockFetch = async () => {
+    return new Response(`<checkVatResponse><valid>false</valid></checkVatResponse>`, {
+      status: 200
+    });
+  };
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'invalid');
+  assert.equal(result.valid, false);
+});
+
+test('vies: http error', async () => {
+  const mockFetch = async () => {
+    return new Response('Service unavailable', { status: 503 });
+  };
+
+  const result = await checkVat('DK12345678', { fetch: mockFetch });
+  assert.equal(result.status, 'unverified');
+  assert.equal(result.valid, null);
+  assert.match(result.reason, /503/);
+});
+
+test('vies: timeout (> 10s)', async () => {
+  const mockFetch = async (url, opts) => {
+    // Simulate abort
