 // VAT number check used by the B2B checkout. See TASK.md.
+
+const VIES_URL = 'https://ec.europa.eu/taxation_customs/vies/services/checkVatService';
+const VIES_TIMEOUT_MS = 10000;
+
+// Format spec per country: [pattern, description]
+// [rules]: minimal format validation; VIES is the real arbiter
+const COUNTRY_FORMATS = {
+  AT: /^\d{9}$/,
+  BE: /^\d{9,12}$/,
+  BG: /^\d{9,10}$/,
+  HR: /^\d{11}$/,
+  CY: /^\d{8}[A-Z]?$/,
+  CZ: /^\d{8,10}$/,
+  DK: /^\d{8}$/,
+  DE: /^\d{11}$/,
+  EE: /^\d{9}$/,
+  EL: /^\d{9}$/,
+  ES: /^\d{8,9}[A-Z]?$/,
+  FI: /^\d{8}$/,
+  FR: /^[A-Z0-9]{2}\d{9}$|^\d{11}$/,
+  HU: /^\d{8}$/,
+  IE: /^\d{7}[A-Z]{1,2}$|^\d{7,8}$/,
+  IT: /^\d{11}$/,
+  LV: /^\d{11}$/,
+  LT: /^\d{12}$/,
+  LU: /^\d{8}$/,
+  MT: /^\d{8}$/,
+  NL: /^\d{12}[A-Z]{2}$/,
+  PL: /^\d{10}$/,
+  PT: /^\d{9}$/,
+  RO: /^\d{5,10}$/,
+  SK: /^\d{10}$/,
+  SI: /^\d{8}$/,
+  SE: /^\d{12}$/,
+  XI: /^\d{5,6}[A-Z]?$/
+};
+
+function normalizeInput(input) {
+  if (typeof input !== 'string') return null;
+  const cleaned = input.trim().replace(/[\s.\-]/g, '').toUpperCase();
+  if (!cleaned) return null;
+
+  // Extract country code (first 2 letters, or XI)
+  const match = cleaned.match(/^([A-Z]{2})(.*)/);
+  if (!match) return null;
+
+  const countryCode = match[1];
+  const vatNumber = match[2];
+
+  return { countryCode, vatNumber };
+}
+
+function validateFormat(countryCode, vatNumber) {
+  const pattern = COUNTRY_FORMATS[countryCode];
+  if (!pattern) return false; // Unknown country code
+  return pattern.test(vatNumber);
+}
+
+function buildSoapRequest(countryCode, vatNumber) {
+  const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+  <soap:Body>
+    <checkVat xmlns="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+      <countryCode>${escapeXml(countryCode)}</countryCode>
+      <vatNumber>${escapeXml(vatNumber)}</vatNumber>
+    </checkVat>
+  </soap:Body>
+</soap:Envelope>`;
+  return xml;
+}
+
+function escapeXml(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function parseSoapResponse(body) {
+  // Simple XML parsing for VIES response
+  // Format: <checkVatResponse><valid>true</valid><name>...</name><address>...</address></checkVatResponse>
+
+  const getTag = (tag) => {
+    const match = body.match(new RegExp(`<${tag}>([^<]*)</${tag}>`));
+    return match ? match[1] : null;
+  };
+
+  const valid = getTag('valid') === 'true';
+  const name = getTag('name');
+  const address = getTag('address');
+
+  return { valid, name, address };
+}
+
 export async function checkVat(input, options = {}) {
-  throw new Error('not implemented');
+  // Use provided fetch, or fall back to global fetch if not specified
+  const fetchImpl = 'fetch' in options ? options.fetch : (typeof fetch !== 'undefined' ? fetch : null);
+
+  const normalized = normalizeInput(input);
+  if (!normalized) {
+    return {
+      status: 'malformed',
+      valid: false
+    };
+  }
+
+  const { countryCode, vatNumber } = normalized;
+
+  // Validate format (malformed check without network call)
+  if (!validateFormat(countryCode, vatNumber)) {
+    return {
+      status: 'malformed',
+      valid: false,
+      countryCode,
+      vatNumber
+    };
+  }
+
+  // Well-formed: verify via VIES
+  try {
+    if (!fetchImpl) {
+      return {
+        status: 'unverified',
+        valid: null,
+        countryCode,
+        vatNumber,
+        reason: 'fetch not available'
+      };
+    }
+
+    const soapRequest = buildSoapRequest(countryCode, vatNumber);
+
+    const controller = new AbortController();
+    const timeoutId = setTimeout(() => controller.abort(), VIES_TIMEOUT_MS);
+
+    try {
+      const response = await fetchImpl(VIES_URL, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'text/xml; charset=UTF-8',
+          'SOAPAction': ''
+        },
+        body: soapRequest,
+        signal: controller.signal
+      });
+
+      clearTimeout(timeoutId);
+
+      if (!response.ok) {
+        return {
+          status: 'unverified',
+          valid: null,
+          countryCode,
+          vatNumber,
+          reason: `VIES service returned ${response.status}`
+        };
+      }
+
+      const body = await response.text();
+      const parsed = parseSoapResponse(body);
+
+      return {
+        status: parsed.valid ? 'valid' : 'invalid',
+        valid: parsed.valid,
+        countryCode,
+        vatNumber,
+        name: parsed.name,
+        address: parsed.address
+      };
+    } catch (err) {
+      clearTimeout(timeoutId);
+
+      if (err.name === 'AbortError') {
+        return {
+          status: 'unverified',
+          valid: null,
+          countryCode,
+          vatNumber,
+          reason: 'VIES service timeout (>10s)'
+        };
+      }
+
+      return {
+        status: 'unverified',
+        valid: null,
+        countryCode,
+        vatNumber,
+        reason: `VIES service unavailable: ${err.message}`
+      };
+    }
+  } catch (err) {
+    return {
+      status: 'unverified',
+      valid: null,
+      countryCode,
+      vatNumber,
+      reason: `Unexpected error: ${err.message}`
+    };
+  }
 }
