 // VAT number check used by the B2B checkout. See TASK.md.
+
+// EU VAT number format validation rules per country
+const vatFormats = {
+  AT: /^U\d{8}$/,           // Austria: U + 8 digits
+  BE: /^\d{10}$/,           // Belgium: 10 digits
+  BG: /^\d{9,10}$/,         // Bulgaria: 9 or 10 digits
+  CY: /^\d{8}[A-Z]$/,       // Cyprus: 8 digits + 1 letter
+  CZ: /^\d{8,10}$/,         // Czech Republic: 8-10 digits
+  DE: /^\d{11}$/,           // Germany: 11 digits
+  DK: /^\d{8}$/,            // Denmark: 8 digits
+  EE: /^\d{9}$/,            // Estonia: 9 digits
+  EL: /^\d{9}$/,            // Greece: 9 digits
+  ES: /^[0-9A-Z]\d{7}[0-9A-Z]$/,  // Spain: digit/letter + 7 digits + digit/letter
+  FI: /^\d{8}$/,            // Finland: 8 digits
+  FR: /^[0-9A-Z]{2}\d{9}$/, // France: 2 chars + 9 digits
+  HR: /^\d{11}$/,           // Croatia: 11 digits
+  HU: /^\d{8}$/,            // Hungary: 8 digits
+  IE: /^[0-9A-Z]\d{5}[0-9A-Z]$|^\d{7}[A-Z]{1,2}$/,  // Ireland: various formats
+  IT: /^\d{11}$/,           // Italy: 11 digits
+  LT: /^\d{12}$/,           // Lithuania: 12 digits
+  LU: /^\d{8}$/,            // Luxembourg: 8 digits
+  LV: /^\d{11}$/,           // Latvia: 11 digits
+  MT: /^\d{8}$/,            // Malta: 8 digits
+  NL: /^\d{9}B\d{2}$/,      // Netherlands: 9 digits + B + 2 digits
+  PL: /^\d{10}$/,           // Poland: 10 digits
+  PT: /^\d{9}$/,            // Portugal: 9 digits
+  RO: /^\d{5,10}$/,         // Romania: 5-10 digits
+  SE: /^\d{12}$/,           // Sweden: 12 digits
+  SI: /^\d{8}$/,            // Slovenia: 8 digits
+  SK: /^\d{10}$/,           // Slovakia: 10 digits
+  XI: /^\d{12}$/,           // Northern Ireland: 12 digits
+};
+
 export async function checkVat(input, options = {}) {
-  throw new Error('not implemented');
+  if (!input || typeof input !== 'string') {
+    return { status: 'malformed', valid: false, reason: 'Input must be a non-empty string' };
+  }
+
+  // Normalize: remove spaces, dots, dashes; uppercase
+  const normalized = input.replace(/[\s.\-]/g, '').toUpperCase();
+
+  // Extract country code and number
+  let countryCode, vatNumber;
+
+  if (normalized.length < 2) {
+    return { status: 'malformed', valid: false, reason: 'VAT number too short' };
+  }
+
+  // Try 2-letter country code first
+  if (/^[A-Z]{2}/.test(normalized)) {
+    countryCode = normalized.slice(0, 2);
+    vatNumber = normalized.slice(2);
+  } else {
+    return { status: 'malformed', valid: false, reason: 'Invalid country code' };
+  }
+
+  // Map EL to EL (Greece special case - already handled above)
+  // XI is Northern Ireland
+
+  // Check if country is supported
+  if (!vatFormats[countryCode]) {
+    return { status: 'malformed', valid: false, reason: `Unsupported country code: ${countryCode}` };
+  }
+
+  // Validate format for the country
+  if (!vatFormats[countryCode].test(vatNumber)) {
+    return { status: 'malformed', valid: false, reason: `Invalid VAT number format for ${countryCode}` };
+  }
+
+  // Format is valid, now verify via VIES service
+  return verifyWithVIES(countryCode, vatNumber, options);
+}
+
+async function verifyWithVIES(countryCode, vatNumber, options) {
+  const fetchImpl = options.fetch || globalThis.fetch;
+  const viesUrl = 'https://ec.europa.eu/taxation_customs/vies/api/checkVat';
+
+  try {
+    const controller = new AbortController();
+    const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout
+
+    const response = await fetchImpl(viesUrl, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams({
+        countryCode,
+        vatNumber,
+      }).toString(),
+      signal: controller.signal,
+    });
+
+    clearTimeout(timeoutId);
+
+    if (!response.ok) {
+      return {
+        status: 'unverified',
+        valid: null,
+        reason: `VIES service returned ${response.status}`,
+      };
+    }
+
+    const contentType = response.headers.get('content-type');
+    let data;
+
+    if (contentType && contentType.includes('application/json')) {
+      data = await response.json();
+    } else if (contentType && contentType.includes('text/xml')) {
+      // Parse XML response from VIES
+      const text = await response.text();
+      data = parseVIESXML(text);
+    } else {
+      // Try JSON first, fallback to XML
+      const text = await response.text();
+      if (text.trim().startsWith('{')) {
+        data = JSON.parse(text);
+      } else {
+        data = parseVIESXML(text);
+      }
+    }
+
+    // VIES returns valid: true/false
+    return {
+      status: data.valid ? 'valid' : 'invalid',
+      valid: data.valid || false,
+      countryCode,
+      vatNumber,
+      name: data.name || undefined,
+      address: data.address || undefined,
+    };
+  } catch (err) {
+    if (err.name === 'AbortError') {
+      return {
+        status: 'unverified',
+        valid: null,
+        reason: 'VIES service timeout (>10 seconds)',
+      };
+    }
+
+    return {
+      status: 'unverified',
+      valid: null,
+      reason: `VIES service error: ${err.message}`,
+    };
+  }
+}
+
+function parseVIESXML(xmlText) {
+  // Simple XML parser for VIES response
+  const result = { valid: false };
+
+  // Extract valid flag
+  const validMatch = xmlText.match(/<valid>(true|false)<\/valid>/i);
+  if (validMatch) {
+    result.valid = validMatch[1].toLowerCase() === 'true';
+  }
+
+  // Extract name
+  const nameMatch = xmlText.match(/<name>(.*?)<\/name>/i);
+  if (nameMatch) {
+    result.name = nameMatch[1];
+  }
+
+  // Extract address
+  const addressMatch = xmlText.match(/<address>(.*?)<\/address>/i);
+  if (addressMatch) {
+    result.address = addressMatch[1];
+  }
+
+  return result;
 }
