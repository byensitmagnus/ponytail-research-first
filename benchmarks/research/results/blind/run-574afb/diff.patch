+  await t.test('returns invalid status for invalid VAT', async () => {
+    const result = await checkVat('DK12345678', {
+      fetch: mockFetch({ valid: false }),
+    });
+    assert.equal(result.status, 'invalid');
+    assert.equal(result.valid, false);
+  });
+});
+
+test('Timeout handling', async (t) => {
+  await t.test('returns unverified on timeout', async () => {
+    const slowFetch = async (url, options) => {
+      const { signal } = options;
+      return new Promise((resolve, reject) => {
+        const listener = () => {
+          const err = new Error('AbortError');
+          err.name = 'AbortError';
+          reject(err);
+        };
+        signal.addEventListener('abort', listener);
+        // Never resolve, wait for abort
+        setTimeout(() => {
+          signal.removeEventListener('abort', listener);
+          reject(new Error('Should not reach here'));
+        }, 15000);
+      });
+    };
+
+    const result = await checkVat('DK12345678', {
+      fetch: slowFetch,
+    });
+    assert.equal(result.status, 'unverified');
+    assert.equal(result.valid, null);
+    assert.match(result.reason, /timeout/i);
+  });
+});
