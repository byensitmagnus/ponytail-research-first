+    const errorFetch = async () => {
+      throw new Error('Network error');
+    };
+
+    const result = await checkVat('DK12345678', {
+      fetch: errorFetch,
+    });
+    assert.equal(result.status, 'unverified');
+    assert.equal(result.valid, null);
+    assert.match(result.reason, /error/i);
+  });
+
+  await t.test('returns unverified on non-200 response', async () => {
+    const result = await checkVat('DK12345678', {
+      fetch: mockFetch({ status: 503 }),
+    });
+    assert.equal(result.status, 'unverified');
+    assert.equal(result.valid, null);
+  });
+});
+
+// Mock fetch implementation
+function mockFetch(response) {
+  return async (url, options) => {
+    if (response.status) {
+      return {
+        ok: response.status === 200,
+        status: response.status,
+        headers: new Map([['content-type', 'application/json']]),
+        json: async () => response,
+      };
+    }
+
+    // Return proper SOAP XML response for valid/invalid
+    const soapResponse = buildSOAPResponse(response);
+
+    return {
+      ok: true,
+      status: 200,
+      headers: new Map([['content-type', 'text/xml']]),
+      text: async () => soapResponse,
+      json: async () => {
+        throw new Error('Not JSON');
+      },
+    };
+  };
+}
+
+function buildSOAPResponse(data) {
+  return `<?xml version="1.0" encoding="UTF-8"?>
+<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
+  <soap:Body>
+    <checkVatResponse xmlns="urn:ec.europa.eu:taxud:vies:services:checkVat:types">
+      <valid>${data.valid ? 'true' : 'false'}</valid>
+      ${data.name ? `<name>${data.name}</name>` : ''}
+      ${data.address ? `<address>${data.address}</address>` : ''}
+    </checkVatResponse>
+  </soap:Body>
+</soap:Envelope>`;
+}
