@@ -9,6 +11,26 @@ with DATA.open(encoding="utf-8") as f:
 
 
 def search(query: str, limit: int = 10) -> list[dict]:
-    """Return up to `limit` products, best match first."""
-    q = query.lower()
-    return [p for p in PRODUCTS if q in p["name"].lower()][:limit]
+    """Return up to `limit` products, best match first.
+
+    Typo-tolerant search using token-based fuzzy matching.
+    Handles misspellings, missing hyphens, and word reordering.
+    """
+    query_lower = query.lower()
+
+    scored = []
+    for product in PRODUCTS:
+        name_lower = product["name"].lower()
+        # Use token_sort_ratio for word reordering, token_set_ratio for subset matching
+        # Take the max to handle both cases: missing words and reordered words
+        score = max(
+            fuzz.token_sort_ratio(query_lower, name_lower),
+            fuzz.token_set_ratio(query_lower, name_lower),
+        )
+        # Only include products with meaningful similarity (>60)
+        if score > 60:
+            scored.append((score, product))
+
+    # Sort by score descending, then by product name for tie-breaking
+    scored.sort(key=lambda x: (-x[0], x[1]["name"]))
+    return [product for _, product in scored[:limit]]
