 import unittest
+import time
 
 from catalog.search import search
 
 
 class SearchTest(unittest.TestCase):
     def test_exact_substring(self):
+        """Exact matches should rank first."""
         self.assertIn("ThinkPad X1 Carbon", search("thinkpad x1 carbon")[0]["name"])
 
+    def test_typo_lenovo(self):
+        """Single and double typos should find product in top 3."""
+        results = search("lenvo thinkpd x1 carbn", limit=3)
+        names = [r["name"] for r in results]
+        found = any("lenovo" in n.lower() and "thinkpad" in n.lower() and "x1 carbon" in n.lower() for n in names)
+        self.assertTrue(found, "Expected Lenovo ThinkPad X1 Carbon in top 3")
+
+    def test_typo_samsung(self):
+        """Missing letters should find product in top 3."""
+        results = search("samsng galxy s24 ultra", limit=3)
+        names = [r["name"] for r in results]
+        found = any("samsung" in n.lower() and "galaxy" in n.lower() and "s24 ultra" in n.lower() for n in names)
+        self.assertTrue(found, "Expected Samsung Galaxy S24 Ultra in top 3")
+
+    def test_missing_hyphen(self):
+        """Missing hyphens/spaces should find product in top 3."""
+        results = search("sony wh1000xm5", limit=3)
+        names = [r["name"] for r in results]
+        found = any("sony" in n.lower() and ("wh-1000xm5" in n.lower() or "wh1000xm5" in n.lower()) for n in names)
+        self.assertTrue(found, "Expected Sony WH-1000XM5 in top 3")
+
+    def test_word_reordering(self):
+        """Words in different order should still find product."""
+        results = search("Carbon X1 ThinkPad", limit=5)
+        names = [r["name"] for r in results]
+        found = any("thinkpad" in n.lower() and "x1 carbon" in n.lower() for n in names)
+        self.assertTrue(found, "Expected ThinkPad X1 Carbon with reordered query")
+
+    def test_no_match_threshold(self):
+        """Very low similarity should return no results."""
+        results = search("zzzzzzzzzzz", limit=10)
+        self.assertEqual(len(results), 0, "Expected no results for nonsense query")
+
+    def test_limit_respected(self):
+        """Result count should not exceed limit."""
+        results = search("lenovo", limit=5)
+        self.assertLessEqual(len(results), 5, "Results should respect limit")
+
+    def test_performance(self):
+        """P95 latency should be under 50ms."""
+        queries = ["lenvo thinkpd x1", "samsng galxy", "sony wh1000xm5", "hp pavilion"] * 100
+        times = []
+        for q in queries:
+            start = time.perf_counter()
+            search(q, limit=10)
+            elapsed = (time.perf_counter() - start) * 1000
+            times.append(elapsed)
+
+        times.sort()
+        p95 = times[int(len(times) * 0.95)]
+        self.assertLess(p95, 50, f"P95 latency {p95:.2f}ms exceeds 50ms target")
+
 
 if __name__ == "__main__":
     unittest.main()
