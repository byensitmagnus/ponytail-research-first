+<?php
+/**
+ * Plugin Name: B2B Pricing
+ * Description: B2B customer support with approval workflow and tiered pricing
+ * Version: 1.0.0
+ */
+
+if (!defined('ABSPATH')) exit;
+
+class B2B_Manager {
+  const META_COMPANY = 'b2b_company_name';
+  const META_VAT = 'b2b_vat_number';
+  const META_APPROVED = 'b2b_approved';
+  const B2B_PRICE_META = '_b2b_price';
+
+  public function __construct() {
+    // Registration form fields
+    add_action('woocommerce_register_form_end', [$this, 'add_registration_fields']);
+    // Save custom fields on registration
+    add_action('woocommerce_created_customer', [$this, 'save_registration_fields']);
+    // Apply B2B pricing filter
+    add_filter('woocommerce_product_get_price', [$this, 'apply_b2b_price'], 10, 2);
+    add_filter('woocommerce_product_variation_get_price', [$this, 'apply_b2b_price'], 10, 2);
+  }
+
+  public function add_registration_fields() {
+    ?>
+    <p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
+      <label for="reg_b2b_company"><?php esc_html_e('Company Name (optional)', 'woocommerce'); ?></label>
+      <input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="b2b_company_name" id="reg_b2b_company" value="<?php echo isset($_POST['b2b_company_name']) ? esc_attr($_POST['b2b_company_name']) : ''; ?>" />
+    </p>
+    <p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
+      <label for="reg_b2b_vat"><?php esc_html_e('VAT Number (optional)', 'woocommerce'); ?></label>
+      <input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="b2b_vat_number" id="reg_b2b_vat" value="<?php echo isset($_POST['b2b_vat_number']) ? esc_attr($_POST['b2b_vat_number']) : ''; ?>" />
+    </p>
+    <?php
+  }
+
+  public function save_registration_fields($customer_id) {
+    if (isset($_POST['b2b_company_name'])) {
+      update_user_meta($customer_id, self::META_COMPANY, sanitize_text_field($_POST['b2b_company_name']));
+    }
+    if (isset($_POST['b2b_vat_number'])) {
+      update_user_meta($customer_id, self::META_VAT, sanitize_text_field($_POST['b2b_vat_number']));
+    }
+  }
+
+  public function apply_b2b_price($price, $product) {
+    // Only apply if user is logged in and approved for B2B
+    $user_id = get_current_user_id();
+    if (!$user_id) return $price;
+
+    // Check if user is approved for B2B
+    $is_approved = get_user_meta($user_id, self::META_APPROVED, true);
+    if (!$is_approved) return $price;
+
+    // Get B2B price from product meta
+    $b2b_price = $product->get_meta(self::B2B_PRICE_META);
+    if ($b2b_price && $b2b_price !== '') {
+      return (float) $b2b_price;
+    }
+
+    return $price;
+  }
+
+  public static function get_user_b2b_info($user_id) {
+    return [
+      'company' => get_user_meta($user_id, self::META_COMPANY, true),
+      'vat' => get_user_meta($user_id, self::META_VAT, true),
+      'approved' => (bool) get_user_meta($user_id, self::META_APPROVED, true),
+    ];
+  }
+
+  public static function approve_b2b_customer($user_id) {
+    update_user_meta($user_id, self::META_APPROVED, 1);
+  }
+
+  public static function unapprove_b2b_customer($user_id) {
+    delete_user_meta($user_id, self::META_APPROVED);
+  }
+}
+
+new B2B_Manager();
