diff --git a/wp-content/mu-plugins/shop-b2b.php b/wp-content/mu-plugins/shop-b2b.php
new file mode 100644
index 0000000..9990222
--- /dev/null
+++ b/wp-content/mu-plugins/shop-b2b.php
@@ -0,0 +1,147 @@
+<?php
+/**
+ * Plugin Name: Shop B2B
+ * Plugin URI: https://example.com
+ * Description: Minimal B2B customer support for WooCommerce
+ * Version: 1.0.0
+ * Author: Shop
+ * License: GPL v2 or later
+ */
+
+if (!defined('ABSPATH')) exit;
+
+// Add custom fields to registration form
+add_action('woocommerce_register_form', 'shop_b2b_register_form_fields');
+function shop_b2b_register_form_fields() {
+	?>
+	<p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
+		<label for="reg_billing_company"><?php esc_html_e('Company Name', 'woocommerce'); ?> <span class="required">*</span></label>
+		<input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="billing_company" id="reg_billing_company" autocomplete="organization" value="<?php echo isset($_POST['billing_company']) ? esc_attr($_POST['billing_company']) : ''; ?>" />
+	</p>
+	<p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
+		<label for="reg_billing_vat_number"><?php esc_html_e('VAT Number', 'woocommerce'); ?> <span class="required">*</span></label>
+		<input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="billing_vat_number" id="reg_billing_vat_number" value="<?php echo isset($_POST['billing_vat_number']) ? esc_attr($_POST['billing_vat_number']) : ''; ?>" />
+	</p>
+	<?php
+}
+
+// Validate and save custom fields on registration
+add_action('woocommerce_register_post', 'shop_b2b_validate_registration', 10, 3);
+function shop_b2b_validate_registration($username, $email, $validation_errors) {
+	if (empty($_POST['billing_company'])) {
+		$validation_errors->add('billing_company_error', __('Company Name is required.', 'woocommerce'));
+	}
+	if (empty($_POST['billing_vat_number'])) {
+		$validation_errors->add('billing_vat_number_error', __('VAT Number is required.', 'woocommerce'));
+	}
+}
+
+// Save B2B fields as user meta after registration
+add_action('woocommerce_created_customer', 'shop_b2b_save_customer_meta', 10, 1);
+function shop_b2b_save_customer_meta($user_id) {
+	if (!empty($_POST['billing_company'])) {
+		update_user_meta($user_id, 'billing_company', sanitize_text_field($_POST['billing_company']));
+	}
+	if (!empty($_POST['billing_vat_number'])) {
+		update_user_meta($user_id, 'billing_vat_number', sanitize_text_field($_POST['billing_vat_number']));
+	}
+	// Mark as B2B applicant (needs approval)
+	if (!empty($_POST['billing_company']) && !empty($_POST['billing_vat_number'])) {
+		update_user_meta($user_id, 'b2b_status', 'pending');
+	}
+}
+
+// Helper: Check if user is B2B approved
+function shop_b2b_is_approved($user_id = null) {
+	if ($user_id === null) {
+		$user_id = get_current_user_id();
+	}
+	if (!$user_id) return false;
+	return get_user_meta($user_id, 'b2b_status', true) === 'approved';
+}
+
+// Apply B2B pricing on product page and cart (single filter handles both)
+add_filter('woocommerce_product_get_price', 'shop_b2b_apply_pricing', 10, 2);
+function shop_b2b_apply_pricing($price, $product) {
+	if (shop_b2b_is_approved()) {
+		// 20% discount for approved B2B (1000 -> 800)
+		return $price * 0.8;
+	}
+	return $price;
+}
+
+// Add B2B fields to customer order
+add_action('woocommerce_checkout_create_order_line_item', 'shop_b2b_add_b2b_info', 10, 4);
+function shop_b2b_add_b2b_info($item, $cart_item_key, $values, $order) {
+	$user_id = $order->get_user_id();
+	if ($user_id && shop_b2b_is_approved($user_id)) {
+		$item->add_meta_data('b2b_customer', 'yes');
+	}
+}
+
+// Admin: Add B2B status column to users list
+add_filter('manage_users_columns', 'shop_b2b_user_columns');
+function shop_b2b_user_columns($columns) {
+	$columns['b2b_status'] = __('B2B Status', 'shop-b2b');
+	return $columns;
+}
+
+add_action('manage_users_custom_column', 'shop_b2b_user_column_content', 10, 3);
+function shop_b2b_user_column_content($output, $column_name, $user_id) {
+	if ($column_name === 'b2b_status') {
+		$status = get_user_meta($user_id, 'b2b_status', true);
+		$company = get_user_meta($user_id, 'billing_company', true);
+		if ($company) {
+			$status_text = $status === 'approved' ? 'Approved' : 'Pending';
+			$class = $status === 'approved' ? 'success' : 'warning';
+			return sprintf('<span style="color: %s; font-weight: bold;">%s</span>', $class === 'success' ? 'green' : 'orange', $status_text);
+		}
+		return '—';
+	}
+	return $output;
+}
+
+// Admin: Add B2B details to user profile
+add_action('show_user_profile', 'shop_b2b_user_profile');
+add_action('edit_user_profile', 'shop_b2b_user_profile');
+function shop_b2b_user_profile($user) {
+	$company = get_user_meta($user->ID, 'billing_company', true);
+	$vat = get_user_meta($user->ID, 'billing_vat_number', true);
+	$status = get_user_meta($user->ID, 'b2b_status', true);
+
+	if ($company || $vat) {
+		?>
+		<h3><?php _e('B2B Information', 'shop-b2b'); ?></h3>
+		<table class="form-table">
+			<tr>
+				<th><label><?php _e('Company Name', 'shop-b2b'); ?></label></th>
+				<td><?php echo esc_html($company); ?></td>
+			</tr>
+			<tr>
+				<th><label><?php _e('VAT Number', 'shop-b2b'); ?></label></th>
+				<td><?php echo esc_html($vat); ?></td>
+			</tr>
+			<tr>
+				<th><label for="b2b_status"><?php _e('B2B Status', 'shop-b2b'); ?></label></th>
+				<td>
+					<select name="b2b_status" id="b2b_status">
+						<option value=""><?php _e('Not B2B', 'shop-b2b'); ?></option>
+						<option value="pending" <?php selected($status, 'pending'); ?>><?php _e('Pending Approval', 'shop-b2b'); ?></option>
+						<option value="approved" <?php selected($status, 'approved'); ?>><?php _e('Approved', 'shop-b2b'); ?></option>
+						<option value="rejected" <?php selected($status, 'rejected'); ?>><?php _e('Rejected', 'shop-b2b'); ?></option>
+					</select>
+				</td>
+			</tr>
+		</table>
+		<?php
+	}
+}
+
+// Save B2B status from user profile
+add_action('personal_options_update', 'shop_b2b_save_profile');
+add_action('edit_user_profile_update', 'shop_b2b_save_profile');
+function shop_b2b_save_profile($user_id) {
+	if (isset($_POST['b2b_status'])) {
+		update_user_meta($user_id, 'b2b_status', sanitize_text_field($_POST['b2b_status']));
+	}
+}
