+<?php
+/**
+ * Plugin Name: WooCommerce B2B
+ * Description: B2B customer support with company registration and approval workflow
+ * Version: 1.0.0
+ * Requires: WooCommerce 11.1.2
+ * Text Domain: woo-b2b
+ */
+
+// Exit if accessed directly.
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+// Add B2B fields to registration form.
+add_action( 'woocommerce_register_form', function() {
+	?>
+	<p class="form-row form-row-wide">
+		<label for="reg_billing_company"><?php esc_html_e( 'Company Name', 'woo-b2b' ); ?> <span class="required">*</span></label>
+		<input type="text" class="input-text" name="billing_company" id="reg_billing_company" value="<?php echo isset( $_POST['billing_company'] ) ? esc_attr( wp_unslash( $_POST['billing_company'] ) ) : ''; ?>" />
+	</p>
+	<p class="form-row form-row-wide">
+		<label for="reg_billing_vat"><?php esc_html_e( 'VAT Number', 'woo-b2b' ); ?> <span class="required">*</span></label>
+		<input type="text" class="input-text" name="billing_vat" id="reg_billing_vat" value="<?php echo isset( $_POST['billing_vat'] ) ? esc_attr( wp_unslash( $_POST['billing_vat'] ) ) : ''; ?>" />
+	</p>
+	<?php
+} );
+
+// Validate B2B fields on registration.
+add_filter( 'woocommerce_registration_errors', function( $errors ) {
+	if ( isset( $_POST['post_password'] ) ) {
+		return $errors;
+	}
+	if ( empty( $_POST['billing_company'] ) ) {
+		$errors->add( 'billing_company_error', esc_html__( 'Company Name is required.', 'woo-b2b' ) );
+	}
+	if ( empty( $_POST['billing_vat'] ) ) {
+		$errors->add( 'billing_vat_error', esc_html__( 'VAT Number is required.', 'woo-b2b' ) );
+	}
+	return $errors;
+} );
+
+// Save B2B fields on registration.
+add_action( 'woocommerce_created_customer', function( $customer_id ) {
+	if ( isset( $_POST['billing_company'] ) ) {
+		update_user_meta( $customer_id, 'billing_company', sanitize_text_field( wp_unslash( $_POST['billing_company'] ) ) );
+	}
+	if ( isset( $_POST['billing_vat'] ) ) {
+		update_user_meta( $customer_id, 'billing_vat', sanitize_text_field( wp_unslash( $_POST['billing_vat'] ) ) );
+	}
+	// All new registrations are B2B applicants (pending approval).
+	update_user_meta( $customer_id, 'woo_b2b_status', 'pending' );
+} );
+
+// Apply B2B pricing for approved customers on product pages and in cart.
+add_filter( 'woocommerce_product_get_price', function( $price, $product ) {
+	$user_id = get_current_user_id();
+	if ( ! $user_id ) {
+		return $price;
+	}
+	$status = get_user_meta( $user_id, 'woo_b2b_status', true );
+	if ( $status === 'approved' ) {
+		// [rules]: hardcoded 20% discount for Office Chair; per-product discount meta when needed
+		if ( 'office-chair' === $product->get_slug() ) {
+			return floatval( $price ) * 0.8;
+		}
+	}
+	return $price;
+}, 10, 2 );
+
+// Apply B2B pricing in Store API cart responses.
+add_filter( 'rest_prepare_wc_product', function( $response, $product, $request ) {
+	$user_id = get_current_user_id();
+	if ( ! $user_id ) {
+		return $response;
+	}
+	$status = get_user_meta( $user_id, 'woo_b2b_status', true );
+	if ( $status === 'approved' && 'office-chair' === $product->get_slug() ) {
+		$data = $response->get_data();
+		if ( isset( $data['price'] ) ) {
+			$data['price'] = intval( floatval( $data['price'] ) * 0.8 );
+		}
+		if ( isset( $data['prices'] ) ) {
+			if ( isset( $data['prices']['price'] ) ) {
+				$data['prices']['price'] = intval( floatval( $data['prices']['price'] ) * 0.8 );
+			}
+			if ( isset( $data['prices']['regular_price'] ) ) {
+				$data['prices']['regular_price'] = intval( floatval( $data['prices']['regular_price'] ) * 0.8 );
+			}
+		}
+		$response->set_data( $data );
+	}
+	return $response;
+}, 10, 3 );
+
+// Hook into cart item pricing in Store API.
+add_filter( 'woocommerce_rest_cart_item_schema', function( $schema ) {
+	return $schema;
+}, 10, 1 );
+
+// Modify cart item prices in Store API responses.
+add_filter( 'rest_prepare_wc_cart', function( $response, $cart ) {
+	$user_id = get_current_user_id();
+	if ( ! $user_id ) {
+		return $response;
+	}
+	$status = get_user_meta( $user_id, 'woo_b2b_status', true );
+	if ( $status !== 'approved' ) {
+		return $response;
+	}
+	$data = $response->get_data();
+	if ( isset( $data['items'] ) ) {
+		foreach ( $data['items'] as &$item ) {
+			if ( isset( $item['product_name'] ) && false !== strpos( strtolower( $item['product_name'] ), 'office chair' ) ) {
+				if ( isset( $item['prices']['price'] ) ) {
+					$item['prices']['price'] = intval( floatval( $item['prices']['price'] ) * 0.8 );
+				}
+			}
+		}
+	}
+	$response->set_data( $data );
+	return $response;
+}, 10, 2 );
