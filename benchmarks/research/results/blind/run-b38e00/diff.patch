+import { useState, useMemo } from 'react';
 import type { Order } from './types.ts';
+import { exportGroupedXlsx } from './exportXlsx.ts';
+
+type SortKey = 'id' | 'date' | 'customer' | 'product' | 'qty' | 'unitPrice' | 'amount';
+type SortDir = 'asc' | 'desc';
 
 export function OrdersTable({ rows }: { rows: Order[] }) {
+  const [filterText, setFilterText] = useState('');
+  const [sortKey, setSortKey] = useState<SortKey>('id');
+  const [sortDir, setSortDir] = useState<SortDir>('asc');
+  const [page, setPage] = useState(0);
+  const [isExporting, setIsExporting] = useState(false);
+
+  const PAGE_SIZE = 25;
+
+  // Filter
+  const filtered = useMemo(() => {
+    if (!filterText) return rows;
+    const lower = filterText.toLowerCase();
+    return rows.filter(
+      (o) =>
+        o.id.toLowerCase().includes(lower) ||
+        o.customer.toLowerCase().includes(lower) ||
+        o.product.toLowerCase().includes(lower) ||
+        o.date.includes(lower)
+    );
+  }, [rows, filterText]);
+
+  // Sort
+  const sorted = useMemo(() => {
+    const arr = [...filtered];
+    arr.sort((a, b) => {
+      let aVal: any;
+      let bVal: any;
+      if (sortKey === 'amount') {
+        aVal = a.qty * a.unitPrice;
+        bVal = b.qty * b.unitPrice;
+      } else {
+        aVal = a[sortKey as keyof Order];
+        bVal = b[sortKey as keyof Order];
+      }
+      const cmp = aVal < bVal ? -1 : aVal > bVal ? 1 : 0;
+      return sortDir === 'asc' ? cmp : -cmp;
+    });
+    return arr;
+  }, [filtered, sortKey, sortDir]);
+
+  // Group by customer
+  const grouped = useMemo(() => {
+    const map = new Map<string, Order[]>();
+    for (const o of sorted) {
+      if (!map.has(o.customer)) map.set(o.customer, []);
+      map.get(o.customer)!.push(o);
+    }
+    return Array.from(map.entries()).sort((a, b) => a[0].localeCompare(b[0]));
+  }, [sorted]);
+
+  // Paginate groups
+  const paged = useMemo(() => grouped.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE), [grouped, page]);
+
+  const handleSort = (key: SortKey) => {
+    if (sortKey === key) {
+      setSortDir(sortDir === 'asc' ? 'desc' : 'asc');
+    } else {
+      setSortKey(key);
+      setSortDir('asc');
+    }
+    setPage(0);
+  };
+
+  const handleExport = async () => {
+    setIsExporting(true);
+    try {
+      const buffer = await exportGroupedXlsx(rows, 'customer');
+      const blob = new Blob([new Uint8Array(buffer)], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
+      const url = URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      a.href = url;
+      a.download = 'orders.xlsx';
+      a.click();
+      URL.revokeObjectURL(url);
+    } finally {
+      setIsExporting(false);
+    }
+  };
+
+  const totalPages = Math.ceil(grouped.length / PAGE_SIZE);
+
   return (
