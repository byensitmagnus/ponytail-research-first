+}
+
+function GroupSection({ customer, orders }: { customer: string; orders: Order[] }) {
+  const totalQty = orders.reduce((sum, o) => sum + o.qty, 0);
+  const totalAmount = orders.reduce((sum, o) => sum + o.qty * o.unitPrice, 0);
+
+  return (
+    <>
+      {orders.map((o) => (
+        <tr key={o.id}>
+          <td style={cellStyle}>{o.customer}</td>
+          <td style={cellStyle}>{o.id}</td>
+          <td style={cellStyle}>{o.date}</td>
+          <td style={cellStyle}>{o.product}</td>
+          <td style={{ ...cellStyle, textAlign: 'right' }}>{o.qty}</td>
+          <td style={{ ...cellStyle, textAlign: 'right' }}>{o.unitPrice.toFixed(2)}</td>
+          <td style={{ ...cellStyle, textAlign: 'right' }}>{(o.qty * o.unitPrice).toFixed(2)}</td>
+        </tr>
+      ))}
+      <tr style={{ backgroundColor: '#e8e8e8', fontWeight: 'bold' }}>
+        <td style={{ ...cellStyle, fontWeight: 'bold' }}>{customer} - Subtotal</td>
+        <td style={cellStyle}></td>
+        <td style={cellStyle}></td>
+        <td style={cellStyle}></td>
+        <td style={{ ...cellStyle, textAlign: 'right', fontWeight: 'bold' }}>{totalQty}</td>
+        <td style={cellStyle}></td>
+        <td style={{ ...cellStyle, textAlign: 'right', fontWeight: 'bold' }}>{totalAmount.toFixed(2)}</td>
+      </tr>
+    </>
   );
 }
+
+const cellStyle: React.CSSProperties = {
+  border: '1px solid #ccc',
+  padding: '0.5rem',
+  textAlign: 'left',
+};
