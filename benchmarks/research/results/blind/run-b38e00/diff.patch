 // See TASK.md for the required behaviour.
 export async function exportGroupedXlsx(rows: Order[], groupBy: 'customer'): Promise<Uint8Array> {
-  throw new Error('not implemented');
+  const workbook = new ExcelJS.Workbook();
+  const sheet = workbook.addWorksheet('Orders');
+
+  // Headers
+  sheet.columns = [
+    { header: 'Customer', key: 'customer', width: 25 },
+    { header: 'Order', key: 'id', width: 12 },
+    { header: 'Date', key: 'date', width: 12 },
+    { header: 'Product', key: 'product', width: 20 },
+    { header: 'Qty', key: 'qty', width: 8 },
+    { header: 'Unit Price', key: 'unitPrice', width: 12 },
+    { header: 'Amount', key: 'amount', width: 12 },
+  ];
+
+  // Group by customer
+  const grouped = new Map<string, Order[]>();
+  for (const row of rows) {
+    if (!grouped.has(row.customer)) {
+      grouped.set(row.customer, []);
+    }
+    grouped.get(row.customer)!.push(row);
+  }
+
+  // Add rows grouped by customer
+  const sortedCustomers = Array.from(grouped.keys()).sort();
+  for (const customer of sortedCustomers) {
+    const customerOrders = grouped.get(customer)!;
+
+    for (const order of customerOrders) {
+      const amount = order.qty * order.unitPrice;
+      sheet.addRow({
+        customer,
+        id: order.id,
+        date: order.date,
+        product: order.product,
+        qty: order.qty,
+        unitPrice: order.unitPrice,
+        amount,
+      });
+    }
+
+    // Subtotal row
+    const totalQty = customerOrders.reduce((sum, o) => sum + o.qty, 0);
+    const totalAmount = customerOrders.reduce((sum, o) => sum + o.qty * o.unitPrice, 0);
+    const subtotalRow = sheet.addRow({
+      customer: `${customer} - Subtotal`,
+      qty: totalQty,
+      amount: totalAmount,
+    });
+    subtotalRow.font = { bold: true };
+
+    // Empty row
+    sheet.addRow({});
+  }
+
+  // Get buffer
+  const buffer = await workbook.xlsx.writeBuffer();
+  return new Uint8Array(buffer as ArrayBuffer);
 }
