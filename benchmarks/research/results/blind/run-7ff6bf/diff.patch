+'use client';
+import { useState, useMemo } from 'react';
 import type { Order } from './types.ts';
+import { exportGroupedXlsx } from './exportXlsx.ts';
+
+type SortKey = keyof Order | 'amount';
+type SortDir = 'asc' | 'desc';
 
 export function OrdersTable({ rows }: { rows: Order[] }) {
+  const [search, setSearch] = useState('');
+  const [sortKey, setSortKey] = useState<SortKey>('customer');
+  const [sortDir, setSortDir] = useState<SortDir>('asc');
+  const [page, setPage] = useState(0);
+  const pageSize = 25;
+
+  // Filter
+  const filtered = useMemo(() => {
+    if (!search) return rows;
+    const q = search.toLowerCase();
+    return rows.filter(
+      (o) =>
+        o.id.toLowerCase().includes(q) ||
+        o.customer.toLowerCase().includes(q) ||
+        o.product.toLowerCase().includes(q)
+    );
+  }, [rows, search]);
+
+  // Sort
+  const sorted = useMemo(() => {
+    return [...filtered].sort((a, b) => {
+      let aVal = sortKey === 'amount' ? a.qty * a.unitPrice : (a[sortKey as keyof Order] as any);
+      let bVal = sortKey === 'amount' ? b.qty * b.unitPrice : (b[sortKey as keyof Order] as any);
+      if (typeof aVal === 'string') aVal = aVal.toLowerCase();
+      if (typeof bVal === 'string') bVal = bVal.toLowerCase();
+      if (aVal < bVal) return sortDir === 'asc' ? -1 : 1;
+      if (aVal > bVal) return sortDir === 'asc' ? 1 : -1;
+      return 0;
+    });
+  }, [filtered, sortKey, sortDir]);
+
+  // Group by customer
+  const grouped = useMemo(() => {
+    const map = new Map<string, Order[]>();
+    for (const o of sorted) {
+      if (!map.has(o.customer)) map.set(o.customer, []);
+      map.get(o.customer)!.push(o);
+    }
+    return Array.from(map.entries());
+  }, [sorted]);
+
+  // Flatten for pagination
+  const flatRows = useMemo(() => {
+    const flat: (Order & { _subtotal?: boolean; _customer?: string; _qtySum?: number; _amountSum?: number })[] = [];
+    for (const [cust, orders] of grouped) {
+      let qtySum = 0, amountSum = 0;
+      for (const o of orders) {
+        flat.push(o);
+        qtySum += o.qty;
+        amountSum += o.qty * o.unitPrice;
+      }
+      flat.push({
+        id: '',
+        date: '',
+        customer: `Subtotal: ${cust}`,
+        product: '',
+        qty: qtySum,
+        unitPrice: 0,
+        _subtotal: true,
+        _customer: cust,
+        _amountSum: amountSum,
+      } as any);
+    }
+    return flat;
+  }, [grouped]);
+
+  const totalPages = Math.ceil(flatRows.length / pageSize);
+  const pageData = flatRows.slice(page * pageSize, (page + 1) * pageSize);
+
+  const handleSort = (key: SortKey) => {
+    if (sortKey === key) {
+      setSortDir(sortDir === 'asc' ? 'desc' : 'asc');
+    } else {
+      setSortKey(key);
+      setSortDir('asc');
+    }
+    setPage(0);
+  };
+
+  const handleExport = async () => {
+    const buf = await exportGroupedXlsx(sorted, 'customer');
+    const blob = new Blob([new Uint8Array(buf)], {
+      type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+    });
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = 'orders.xlsx';
+    a.click();
+    URL.revokeObjectURL(url);
+  };
+
   return (
-    <table>
-      <thead>
-        <tr>
-          <th>Order</th>
-          <th>Date</th>
-          <th>Customer</th>
-          <th>Product</th>
-          <th>Qty</th>
-          <th>Unit price</th>
-          <th>Amount</th>
-        </tr>
-      </thead>
-      <tbody>
-        {rows.map((o) => (
-          <tr key={o.id}>
-            <td>{o.id}</td>
-            <td>{o.date}</td>
-            <td>{o.customer}</td>
-            <td>{o.product}</td>
-            <td>{o.qty}</td>
-            <td>{o.unitPrice.toFixed(2)}</td>
-            <td>{(o.qty * o.unitPrice).toFixed(2)}</td>
+    <div style={{ padding: '1rem' }}>
+      <div style={{ marginBottom: '1rem' }}>
+        <input
+          type="text"
+          placeholder="Filter by order, customer, or product..."
+          value={search}
+          onChange={(e) => {
+            setSearch(e.target.value);
+            setPage(0);
+          }}
+          style={{ padding: '0.5rem', width: '300px', marginRight: '1rem' }}
+        />
+        <button onClick={handleExport} style={{ padding: '0.5rem 1rem' }}>
+          Export to Excel
+        </button>
+      </div>
+
+      <table style={{ width: '100%', borderCollapse: 'collapse' }}>
+        <thead>
+          <tr style={{ backgroundColor: '#f0f0f0' }}>
+            {(['id', 'date', 'customer', 'product', 'qty', 'unitPrice', 'amount'] as SortKey[]).map((k) => (
+              <th
+                key={k}
+                onClick={() => handleSort(k)}
+                style={{ padding: '0.5rem', border: '1px solid #ccc', cursor: 'pointer', userSelect: 'none' }}
+              >
+                {k === 'id'
+                  ? 'Order'
+                  : k === 'unitPrice'
+                    ? 'Unit price'
+                    : k === 'amount'
+                      ? 'Amount'
+                      : k.charAt(0).toUpperCase() + k.slice(1)}
+                {sortKey === k && <span>{sortDir === 'asc' ? ' ↑' : ' ↓'}</span>}
+              </th>
+            ))}
           </tr>
-        ))}
-      </tbody>
-    </table>
+        </thead>
+        <tbody>
+          {pageData.map((o, idx) => (
+            <tr
+              key={o._subtotal ? `subtotal-${o._customer}` : o.id}
+              style={{
+                backgroundColor: o._subtotal ? '#ffffcc' : idx % 2 === 0 ? '#fafafa' : 'white',
+                fontWeight: o._subtotal ? 'bold' : 'normal',
+              }}
+            >
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc' }}>{o.id}</td>
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc' }}>{o.date}</td>
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc' }}>{o.customer}</td>
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc' }}>{o.product}</td>
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc', textAlign: 'right' }}>{o.qty}</td>
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc', textAlign: 'right' }}>
+                {o.unitPrice ? o.unitPrice.toFixed(2) : ''}
+              </td>
+              <td style={{ padding: '0.5rem', border: '1px solid #ccc', textAlign: 'right' }}>
+                {o._subtotal ? (o._amountSum || 0).toFixed(2) : (o.qty * o.unitPrice).toFixed(2)}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+
+      <div style={{ marginTop: '1rem', textAlign: 'center' }}>
+        <button onClick={() => setPage(Math.max(0, page - 1))} disabled={page === 0}>
+          Prev
+        </button>
+        <span style={{ margin: '0 1rem' }}>
+          Page {page + 1} of {Math.max(1, totalPages)}
+        </span>
+        <button onClick={() => setPage(Math.min(totalPages - 1, page + 1))} disabled={page >= totalPages - 1}>
+          Next
+        </button>
+      </div>
+    </div>
   );
 }
