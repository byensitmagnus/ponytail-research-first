-// See TASK.md for the required behaviour.
 export async function exportGroupedXlsx(rows: Order[], groupBy: 'customer'): Promise<Uint8Array> {
-  throw new Error('not implemented');
+  const wb = new ExcelJS.Workbook();
+  const ws = wb.addWorksheet('Orders');
+
+  // Headers
+  ws.columns = [
+    { header: 'Customer', key: 'customer', width: 20 },
+    { header: 'Order ID', key: 'id', width: 12 },
+    { header: 'Date', key: 'date', width: 12 },
+    { header: 'Product', key: 'product', width: 20 },
+    { header: 'Qty', key: 'qty', width: 8 },
+    { header: 'Unit Price', key: 'unitPrice', width: 12 },
+    { header: 'Amount', key: 'amount', width: 12 },
+  ];
+
+  // Group by customer
+  const grouped = new Map<string, Order[]>();
+  for (const row of rows) {
+    if (!grouped.has(row.customer)) grouped.set(row.customer, []);
+    grouped.get(row.customer)!.push(row);
+  }
+
+  // Write grouped data with subtotals
+  let rowNum = 2;
+  for (const [customer, custOrders] of grouped) {
+    let qtySum = 0, amountSum = 0;
+    for (const order of custOrders) {
+      const amount = order.qty * order.unitPrice;
+      ws.insertRows(rowNum, [
+        { customer, id: order.id, date: order.date, product: order.product, qty: order.qty, unitPrice: order.unitPrice, amount }
+      ]);
+      qtySum += order.qty;
+      amountSum += amount;
+      rowNum++;
+    }
+    // Subtotal row
+    ws.insertRows(rowNum, [
+      { customer: `Subtotal: ${customer}`, id: '', date: '', product: '', qty: qtySum, unitPrice: '', amount: amountSum }
+    ]);
+    ws.getRow(rowNum).font = { bold: true };
+    rowNum++;
+  }
+
+  const buffer = await wb.xlsx.writeBuffer();
+  return new Uint8Array(buffer as any);
 }
