+type SortKey = keyof Order | 'amount';
+type SortDir = 'asc' | 'desc';
 
 export function OrdersTable({ rows }: { rows: Order[] }) {
+  const [filter, setFilter] = useState('');
+  const [sortKey, setSortKey] = useState<SortKey>('date');
+  const [sortDir, setSortDir] = useState<SortDir>('desc');
+  const [page, setPage] = useState(0);
+  const [exporting, setExporting] = useState(false);
+
+  const ROWS_PER_PAGE = 25;
+
+  const filtered = useMemo(() => {
+    const q = filter.toLowerCase();
+    return rows.filter(
+      (o) =>
+        o.id.toLowerCase().includes(q) ||
+        o.customer.toLowerCase().includes(q) ||
+        o.product.toLowerCase().includes(q) ||
+        o.date.includes(q)
+    );
+  }, [rows, filter]);
+
+  const sorted = useMemo(() => {
+    const copy = [...filtered];
+    copy.sort((a, b) => {
+      let aVal = a[sortKey as keyof Order];
+      let bVal = b[sortKey as keyof Order];
+
+      if (sortKey === 'amount') {
+        aVal = a.qty * a.unitPrice;
+        bVal = b.qty * b.unitPrice;
+      }
+
+      if (typeof aVal === 'string') {
+        return sortDir === 'asc'
+          ? aVal.localeCompare(bVal as string)
+          : (bVal as string).localeCompare(aVal);
+      }
+
+      const diff = (aVal as number) - (bVal as number);
+      return sortDir === 'asc' ? diff : -diff;
+    });
+    return copy;
+  }, [filtered, sortKey, sortDir]);
+
+  // Group by customer for display
+  const grouped = useMemo(() => {
+    const groups: Array<{ customer: string; orders: Order[] }> = [];
+    const seen = new Set<string>();
+
+    for (const order of sorted) {
+      if (!seen.has(order.customer)) {
+        seen.add(order.customer);
+        groups.push({ customer: order.customer, orders: [] });
+      }
+      groups[groups.length - 1].orders.push(order);
+    }
+
+    return groups;
+  }, [sorted]);
+
+  // Flatten grouped for pagination
+  let displayRows: Array<{ type: 'header' | 'order' | 'subtotal'; order?: Order; customer?: string; qtySum?: number; amountSum?: number }> = [];
+  for (const group of grouped) {
+    displayRows.push({ type: 'header', customer: group.customer });
+    for (const order of group.orders) {
+      displayRows.push({ type: 'order', order });
+    }
+    const qtySum = group.orders.reduce((s, o) => s + o.qty, 0);
+    const amountSum = group.orders.reduce((s, o) => s + o.qty * o.unitPrice, 0);
+    displayRows.push({
+      type: 'subtotal',
+      customer: `${group.customer} Subtotal`,
+      qtySum,
+      amountSum,
+    });
+  }
+
+  const paginatedRows = displayRows.slice(
+    page * ROWS_PER_PAGE,
+    (page + 1) * ROWS_PER_PAGE
+  );
+  const maxPage = Math.ceil(displayRows.length / ROWS_PER_PAGE) || 1;
+
+  const handleSort = (key: SortKey) => {
+    if (sortKey === key) {
+      setSortDir(sortDir === 'asc' ? 'desc' : 'asc');
+    } else {
+      setSortKey(key);
+      setSortDir('asc');
+    }
+    setPage(0);
+  };
+
+  const handleExport = async () => {
+    setExporting(true);
+    try {
+      const bytes = await exportGroupedXlsx(sorted, 'customer');
+      const blob = new Blob([bytes as any], {
+        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+      });
+      const url = URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      a.href = url;
+      a.download = `orders-${new Date().toISOString().split('T')[0]}.xlsx`;
+      a.click();
+      URL.revokeObjectURL(url);
+    } finally {
+      setExporting(false);
+    }
+  };
+
+  const SortIndicator = ({ active, dir }: { active: boolean; dir: SortDir }) =>
+    active ? (dir === 'asc' ? ' ↑' : ' ↓') : '';
+
   return (
