@@ -1,6 +1,72 @@
 import type { Order } from './types.ts';
+import ExcelJS from 'exceljs';
 
-// See TASK.md for the required behaviour.
 export async function exportGroupedXlsx(rows: Order[], groupBy: 'customer'): Promise<Uint8Array> {
-  throw new Error('not implemented');
+  const workbook = new ExcelJS.Workbook();
+  const sheet = workbook.addWorksheet('Orders');
+
+  // Headers
+  sheet.columns = [
+    { header: 'Order', key: 'id', width: 12 },
+    { header: 'Date', key: 'date', width: 12 },
+    { header: 'Customer', key: 'customer', width: 20 },
+    { header: 'Product', key: 'product', width: 20 },
+    { header: 'Qty', key: 'qty', width: 8 },
+    { header: 'Unit price', key: 'unitPrice', width: 12 },
+    { header: 'Amount', key: 'amount', width: 12 },
+  ];
+
+  sheet.getRow(1).font = { bold: true };
+
+  // Group by customer
+  const grouped: Record<string, Order[]> = {};
+  for (const order of rows) {
+    const customer = order.customer;
+    if (!grouped[customer]) grouped[customer] = [];
+    grouped[customer].push(order);
+  }
+
+  let rowNum = 2;
+  for (const [customer, orders] of Object.entries(grouped)) {
+    let qtySum = 0;
+    let amountSum = 0;
+
+    // Customer header
+    const customerHeaderRow = sheet.getRow(rowNum);
+    customerHeaderRow.getCell(3).value = customer;
+    customerHeaderRow.font = { bold: true, italic: true };
+    rowNum++;
+
+    // Order rows
+    for (const order of orders) {
+      const amount = order.qty * order.unitPrice;
+      qtySum += order.qty;
+      amountSum += amount;
+
+      sheet.getRow(rowNum).values = {
+        id: order.id,
+        date: order.date,
+        customer: '',
+        product: order.product,
+        qty: order.qty,
+        unitPrice: order.unitPrice,
+        amount,
+      };
+      rowNum++;
+    }
+
+    // Subtotal row
+    const subtotalRow = sheet.getRow(rowNum);
+    subtotalRow.getCell(3).value = `${customer} Subtotal`;
+    subtotalRow.getCell(5).value = qtySum;
+    subtotalRow.getCell(7).value = amountSum;
+    subtotalRow.font = { bold: true };
+    rowNum++;
+
+    // Blank row
+    rowNum++;
+  }
+
+  const buffer = await workbook.xlsx.writeBuffer();
+  return new Uint8Array(buffer);
 }
